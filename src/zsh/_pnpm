# -----------------------------------------------------------------------------
# Helpers.

(( $+functions[_pnpm__message] )) ||
_pnpm__message() {
  _message "${1:-value}"
}

# The global specs, minus the option tokens given as arguments (the ones the
# current command declares itself), in reply. _arguments has to run in the
# handler itself: the words it narrows for a `*::` state do not survive a
# wrapper function's return.
(( $+functions[_pnpm__globals] )) ||
_pnpm__globals() {
  local k
  reply=()
  for k in ${(k)_pnpm_global_specs}; do
    (( ${@[(Ie)$k]} )) || reply+=("$_pnpm_global_specs[$k]")
  done
}

# Index (in $words) of the first positional argument before the cursor, in
# REPLY. Fails when there is none yet. The array named by $1 lists the option
# tokens of the current command that take a separate value.
(( $+functions[_pnpm__passthrough_at] )) ||
_pnpm__passthrough_at() {
  local -a _vo
  _vo=(${(P)1} $_pnpm_global_value_options)
  local -i i=2
  while (( i < CURRENT )); do
    case $words[i] in
      (--) (( i + 1 <= CURRENT )) && { REPLY=$(( i + 1 )); return 0 } ;;
      (--*=*) ;;
      (-?*)
        (( ${_vo[(Ie)$words[i]]} )) && (( i++ ))
        ;;
      (*) REPLY=$i; return 0 ;;
    esac
    (( i++ ))
  done
  REPLY=$CURRENT
  [[ $PREFIX != -* ]] && (( CURRENT > 1 ))
}

# The pnpm command line words that pick the project: -C/--dir/--prefix and
# -w/--workspace-root, from the line as typed.
(( $+functions[_pnpm__project_args] )) ||
_pnpm__project_args() {
  local -a w
  w=("${(@)_pnpm_line_words[2,-1]}")
  reply=()
  local -i i=1
  while (( i < ${#w} )); do
    case $w[i] in
      (-C|--dir|--prefix) reply+=(--dir "${(Q)w[i+1]}"); (( i++ )) ;;
      (-C?*) reply+=(--dir "${(Q)${w[i]#-C}#=}") ;;
      (--dir=*|--prefix=*) reply+=(--dir "${(Q)w[i]#*=}") ;;
      (-w|--workspace-root) reply+=(--workspace-root) ;;
    esac
    (( i++ ))
  done
}

# pnpm's own completion endpoint. It is exempt from the packageManager pin
# check, reads only local files, and escapes colons for _describe when SHELL
# is exactly `zsh`.
(( $+functions[_pnpm__engine] )) ||
_pnpm__engine() {
  local tag=$1; shift
  local -a reply
  _pnpm__project_args
  _call_program $tag SHELL=zsh pnpm completion-server -- pnpm ${(q)reply} ${(q)@} "''" 2>/dev/null
}

(( $+functions[_pnpm__scripts] )) ||
_pnpm__scripts() {
  local -a scripts
  scripts=(${(f)"$(_pnpm__engine scripts run)"})
  _describe -t scripts 'package script' scripts
}

(( $+functions[_pnpm__workspace_packages] )) ||
_pnpm__workspace_packages() {
  local -a pkgs
  compset -P '[.!^]#'
  pkgs=(${(f)"$(_pnpm__engine workspace-packages --filter)"})
  _describe -t workspace-packages 'workspace package' pkgs
}

# Dependency names from the nearest package.json, read locally: pnpm's own
# query commands obey a packageManager pin and may start another pnpm.
(( $+functions[_pnpm__dependencies] )) ||
_pnpm__dependencies() {
  local -a reply deps
  local dir=$PWD manifest
  _pnpm__project_args
  local -i i=${reply[(I)--dir]}
  (( i )) && dir=${~reply[i+1]}
  [[ $dir == /* ]] || dir=$PWD/$dir
  while [[ $dir != / && ! -f $dir/package.json ]]; do dir=${dir:h}; done
  manifest=$dir/package.json
  [[ -f $manifest ]] || { _message 'package name'; return 1 }
  if (( $+commands[node] )); then
    deps=(${(f)"$(_call_program dependencies node -e ${(q)_pnpm_deps_js} ${(q)manifest} 2>/dev/null)"})
  elif (( $+commands[jq] )); then
    deps=(${(f)"$(_call_program dependencies jq -r ${(q)_pnpm_deps_jq} ${(q)manifest} 2>/dev/null)"})
  fi
  _wanted dependencies expl 'dependency' compadd -a deps
}
