# The pnpm command line from $words[1] on, where $words[1] is the program name
# or a prefix (`pm`, `recursive`, `with <version>`) standing in for it.
(( $+functions[_pnpm__root] )) ||
_pnpm__root() {
  local curcontext=$curcontext state state_descr line ret=1
  typeset -A opt_args
  local -a reply
  _pnpm__globals
  _arguments -s -S -C : $reply $_pnpm_root_specs \
    '1: :->command' \
    '*::arg:->args' && ret=0
  case $state in
    (command) _pnpm__commands && ret=0 ;;
    (args)
      curcontext=${curcontext%:*:*}:pnpm-$words[1]:
      _pnpm__dispatch && ret=0
      ;;
  esac
  return ret
}

