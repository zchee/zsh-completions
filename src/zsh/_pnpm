# Hand-dispatched words of commands that take a free parameter list. Only the
# first parameter is a word; later ones are the command's arguments.
(( $+functions[_pnpm__hand_words] )) ||
_pnpm__hand_words() {
  local cmd=$1
  local -a ws
  local -i i n=0
  for (( i = 2; i < CURRENT; i++ )); do
    [[ $words[i] == -* ]] || (( n++ ))
  done
  if (( n == 0 )); then
    case $cmd in
      (access) ws=('list:list packages or collaborators' 'ls:list packages' 'get:get status' 'set:set status=<public|restricted> or mfa=<none|publish|automation>' 'public:set the package public' 'restricted:set the package restricted' 'grant:grant a team access: grant <read-only|read-write> <scope:team> [pkg]' 'revoke:revoke a team'\''s access: revoke <scope:team> [pkg]') ;;
      (audit) ws=('signatures:verify registry signatures of the installed packages') ;;
      (licenses) ws=('list:list the licenses of installed packages' 'ls:list the licenses of installed packages') ;;
      (dist-tag) ws=('add:add a tag: add <pkg>@<version> [tag]' 'rm:remove a tag: rm <pkg> <tag>' 'ls:list tags: ls [pkg]' 'list:list tags: list [pkg]') ;;
      (stage) ws=('publish:stage packages for publishing' 'list:list staged packages' 'view:view a staged package' 'approve:approve a staged package' 'reject:reject a staged package' 'download:download a staged package') ;;
      (peers) ws=('check:check for unmet or missing peer dependencies') ;;
      (runtime) ws=('set:set a runtime: set <node|deno|bun> <version>') ;;
      (env) ws=('use:install and activate a Node.js version' 'list:list installed Node.js versions' 'remove:remove Node.js versions' 'ls:(hidden) list installed Node.js versions' 'rm:(hidden) remove Node.js versions' 'uninstall:(hidden) remove Node.js versions' 'un:(hidden) remove Node.js versions') ;;
      (shim) ws=('add:add a context-aware shim for a package' 'rm:remove shims' 'ls:list shims' 'remove:(hidden) remove shims' 'uninstall:(hidden) remove shims' 'list:(hidden) list shims') ;;
      (team) ws=('create:create a team: create <scope:team>' 'destroy:destroy a team: destroy <scope:team>' 'add:add a user: add <scope:team> <user>' 'rm:remove a user: rm <scope:team> <user>' 'ls:list teams or members: ls <scope|scope:team>' 'list:(hidden) list teams or members: list <scope|scope:team>') ;;
      (owner) ws=('ls:list owners: ls [pkg]' 'list:list owners: list [pkg]' 'add:add an owner: add <user> [pkg]' 'rm:remove an owner: rm <user> [pkg]') ;;
    esac
    _describe -t subcommands "$cmd subcommand" ws
    return
  fi
  local -a params=(${(@)${(@)words[2,CURRENT-1]}:#-*})
  case "$cmd $params[1]" in
    ("access list") (( n == 1 )) && { compadd packages collaborators; return } ;;
    ("access ls") (( n == 1 )) && { compadd packages; return } ;;
    ("access get") (( n == 1 )) && { compadd status; return } ;;
    ("access set")
      if (( n == 1 )); then
        if compset -P 'status='; then compadd public restricted private
        elif compset -P 'mfa='; then compadd none publish automation
        else compadd -S '' status= mfa=
        fi
        return
      fi
      ;;
    ("access grant") (( n == 1 )) && { compadd read-only read-write; return } ;;
    ("runtime set")
      (( n == 1 )) && { _wanted runtimes expl runtime compadd node deno bun; return }
      (( n == 2 )) && { _message 'runtime version'; return }
      ;;
    ("env use"|"env remove"|"env rm"|"env uninstall"|"env un") _message 'Node.js version'; return ;;
    ("dist-tag add") _message 'pkg@version, then tag'; return ;;
    ("dist-tag rm"|"dist-tag ls"|"dist-tag list"|"owner ls"|"owner list") _message 'package name'; return ;;
    ("owner add"|"owner rm") _message 'username, then package name'; return ;;
    ("shim add"|"shim rm"|"shim remove"|"shim uninstall") _message 'package name'; return ;;
    ("team "*) _message 'scope:team, then username'; return ;;
  esac
  _message 'argument'
}

