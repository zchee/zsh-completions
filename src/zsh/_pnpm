    case $words[2] in
      (tasks) subs=('status:Show running and waiting tasks in concurrency groups') ;;
      (config|c) subs=('set:Set the config key to the value provided' 'get:Print the config value for the provided key' 'delete:Remove the config key from the config file' 'list:Show all the config settings') ;;
      (pkg) subs=('get:Retrieves a value from package.json' 'set:Sets a value in package.json' 'delete:Deletes a key from package.json' 'fix:Auto corrects common errors in package.json') ;;
      (store) subs=('status:Checks for modified packages in the store. Returns exit code 0 if the content of the package is the same as it was at the time of unpacking' 'add:Functionally equivalent to pnpm add, except this adds new packages to the store directly without modifying any projects or files outside of...' 'prune:Removes unreferenced packages from the store. Unreferenced packages are packages that are not used by any projects on the system.' 'path:Returns the path to the active store directory') ;;
      (cache) subs=('list:Lists the available packages metadata cache. Supports filtering by glob' 'list-registries:Lists all registries that have their metadata cache locally' 'path:Prints the path to the cache directory' 'view:Views information from the specified package'\''s cache' 'delete:Deletes metadata cache for the specified package(s). Supports patterns' 'prune:Deletes registry metadata cache directories that this version of pnpm can no longer read') ;;
