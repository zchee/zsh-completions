# Build the option specs for a command scope into $reply: every accepted token,
# with "(hidden)" leading the description of those `--help` does not print.
_npm__option_specs() {
  local scope=$1 tok spec line
  local -A vis own
  for tok in ${(s: :)_npm_visible_options[$scope]}; do
    vis[$tok]=1
  done
  for line in ${(f)_npm_scoped_option_specs[$scope]}; do
    own[${line%%$'\t'*}]=${line#*$'\t'}
  done
  reply=()
  for tok spec in "${(@kv)_npm_option_specs}"; do
    (( $+own[$tok] )) && continue
    if (( $+vis[$tok] )); then
      reply+=( "$spec" )
    else
      reply+=( "${spec/\[/[(hidden) }" )
    fi
  done
  for tok spec in "${(@kv)own}"; do
    if (( $+vis[$tok] )); then
      reply+=( "$spec" )
    else
      reply+=( "${spec/\[/[(hidden) }" )
    fi
  done
}

# Run _arguments for a command scope: its options plus the given positional specs.
_npm__args() {
  local scope=$1
  shift
  local -a reply
  _npm__option_specs "$scope"
  _arguments -s -S : "${reply[@]}" "$@"
}

# -----------------------------------------------------------------------------
# Commands.
# -----------------------------------------------------------------------------

# Resolve a typed command name the way npm's deref() does: camelCase to
# kebab-case, exact command, alias, then a unique prefix of any command or alias.
_npm__deref() {
  emulate -L zsh -o extendedglob
  local c=$1 a
  local -a names cands
  [[ $c == *[A-Z]* ]] && c=${c//(#b)([A-Z])/-${(L)match[1]}}
  if (( $+_npm_command_descriptions[$c] )); then
    REPLY=$c
    return 0
  fi
  if (( $+_npm_aliases[$c] )); then
    REPLY=$_npm_aliases[$c]
    return 0
  fi
  REPLY=
  [[ -n $c ]] || return 1
  names=( ${(k)_npm_command_descriptions} ${(k)_npm_aliases} )
  cands=( ${(M)names:#${(b)c}*} )
  (( $#cands == 1 )) || return 1
  a=$cands[1]
  while (( $+_npm_aliases[$a] )); do
    a=$_npm_aliases[$a]
  done
  REPLY=$a
}

_npm__commands() {
  local k ret=1
  local -a cmds als
  for k in ${(ko)_npm_command_descriptions}; do
    cmds+=( "${k}:${_npm_command_descriptions[$k]//:/\\:}" )
  done
  for k in ${(ko)_npm_aliases}; do
    (( ${_npm_unlisted_aliases[(Ie)$k]} )) && continue
    als+=( "${k}:alias for ${_npm_aliases[$k]}" )
  done
  _describe -t commands 'npm command' cmds && ret=0
  _describe -t command-aliases 'npm command alias' als && ret=0
  return ret
}

_npm__subcommands() {
  local -a subs
  subs=( ${(f)_npm_subcommands[$1]} )
  _describe -t subcommands "npm $1 subcommand" subs
}

# -----------------------------------------------------------------------------
# Local state.
# -----------------------------------------------------------------------------

# Directory npm treats as the local prefix for a file or directory named $1:
# --prefix/-C from the command line, else the nearest ancestor holding $1.
_npm__find_up() {
  local i dir w
  for (( i = 2; i <= $#_npm_line_words; i++ )); do
    w=$_npm_line_words[i]
    case $w in
      (--prefix|-C) dir=$_npm_line_words[i+1] ;;
      (--prefix=*) dir=${w#--prefix=} ;;
    esac
  done
  if [[ -n $dir ]]; then
    REPLY=${dir/#\~/$HOME}
    return 0
  fi
  dir=$PWD
  while :; do
    if [[ -e $dir/$1 ]]; then
      REPLY=$dir
      return 0
    fi
    [[ $dir == / ]] && break
    dir=${dir:h}
  done
  REPLY=
  return 1
}

# Whether the command line operates on the global prefix.
_npm__is_global() {
  local -a w
  local i
  w=( "${_npm_line_words[@]}" )
  (( ${w[(I)(-g|--global|--location=global|-[A-Za-z]#g[A-Za-z]#)]} )) && return 0
  i=${w[(I)(-L|--location)]}
  (( i )) && [[ $w[i+1] == global ]]
}

_npm__global_root() {
  REPLY=$(_call_program npm-global-root npm root -g --no-update-notifier --loglevel=silent 2>/dev/null)
  [[ -n $REPLY ]]
}

# Packages directly under a node_modules directory: the local one, or the
# global one when -g is on the line.
_npm__installed() {
  local root expl REPLY
  local -a pkgs
  if _npm__is_global; then
    _npm__global_root || return 1
    root=$REPLY
  else
    if ! _npm__find_up node_modules; then
      _message 'installed package (no node_modules found)'
      return 1
    fi
    root=$REPLY/node_modules
  fi
  pkgs=( $root/[^.@]*(N-/) $root/@*/[^.]*(N-/) )
  pkgs=( ${pkgs#$root/} )
  _wanted packages expl 'installed package' compadd -a - pkgs
}

_npm__global_packages() {
  local root expl REPLY
  local -a pkgs
  _npm__global_root || return 1
  root=$REPLY
  pkgs=( $root/[^.@]*(N-/) $root/@*/[^.]*(N-/) )
  pkgs=( ${pkgs#$root/} )
  _wanted packages expl 'globally installed package' compadd -a - pkgs
}

# npm link takes a globally installed package name or a package folder.
_npm__link_targets() {
  local ret=1
  _npm__global_packages && ret=0
  _files -/ && ret=0
  return ret
}

# Executables of the local node_modules/.bin, for npm exec.
_npm__bins() {
  local expl REPLY
  local -a bins
  if _npm__find_up node_modules; then
    bins=( $REPLY/node_modules/.bin/*(N:t) )
  fi
  if (( $#bins )); then
    _wanted commands expl 'local package binary' compadd -a - bins
  else
    _message 'package spec or command'
  fi
}

# A package spec for install: complete paths once the word looks like one
# (npm itself completes only folders), otherwise there is nothing local to offer.
_npm__package_specs() {
  if [[ $PREFIX == (.|/|\~)* || $PREFIX == */* && $PREFIX != @*/* ]]; then
    _files
  else
    _message 'package spec (name[@version], scope/name, git url, tarball or folder)'
  fi
}

_npm__scripts() {
  local dir REPLY
  local -a scripts
  if ! _npm__find_up package.json; then
    _message 'script (no package.json found)'
    return 1
  fi
  dir=$REPLY
  scripts=( ${(f)"$(_call_program npm-scripts node -e '"$_npm_js_scripts"' '"$dir/package.json"' 2>/dev/null)"} )
  _describe -t scripts 'package script' scripts
}

_npm__pkg_fields() {
  local dir expl REPLY
  local -a fields
  _npm__find_up package.json || return 1
  dir=$REPLY
  fields=( ${(f)"$(_call_program npm-pkg-fields node -e '"$_npm_js_fields"' '"$dir/package.json"' 2>/dev/null)"} )
  _wanted fields expl 'package.json field' compadd "$@" -a - fields
}

# npm pkg set <field>=<value>.
_npm__pkg_kv() {
  if compset -P '*='; then
    _message "value of ${IPREFIX%=}"
  else
    _npm__pkg_fields -qS=
  fi
}

_npm__workspaces() {
  local -a ws
  ws=( ${(f)"$(_call_program npm-workspaces node -e '"$_npm_js_workspaces"' '"$PWD"' 2>/dev/null)"} )
  if (( $#ws )); then
    _describe -t workspaces 'workspace' ws
  else
    _message 'workspace name or path'
  fi
}

_npm__local_addresses() {
  local -a addrs
  addrs=( ${(f)"$(_call_program npm-addresses node -e '"$_npm_js_addresses"' 2>/dev/null)"} )
  _describe -t addresses 'local address' addrs
}

_npm__browsers() {
  _alternative 'values:value:(true false)' 'commands:browser command:_command_names -e'
}

_npm__help_topics() {
  local expl npmroot
  local -aU topics
  npmroot=${commands[npm]:A:h:h}
  if [[ -d $npmroot/man ]]; then
    topics=( help $npmroot/man/man[0-9]/*.[0-9](N:t:r) )
    topics=( ${topics#npm-} )
  else
    # A shim (nodenv, volta) hides the package; ask npm's own completion.
    local -x COMP_CWORD=2 COMP_LINE='npm help ' COMP_POINT=9
    topics=( ${(f)"$(_call_program npm-help-topics npm completion --no-update-notifier --loglevel=silent -- npm help "''" 2>/dev/null)"} )
  fi
  _wanted topics expl 'help topic' compadd -a - topics
}

# -----------------------------------------------------------------------------
# Config keys and values.
# -----------------------------------------------------------------------------

_npm__config_keys() {
  _describe -t config-keys 'config key' _npm_config_keys "$@"
}

_npm__config_value() {
  local key=$1 expl action
  local -a vals
  action=$_npm_config_values[$key]
  case $action in
    ('('*')')
      vals=( ${(z)${${action#\(}%\)}} )
      _wanted values expl "value of $key" compadd -a - vals
      ;;
    (?*) eval "${action# }" ;;
    (*) _message "value of $key" ;;
  esac
}

# npm config set <key>=<value>; deprecated keys are refused by npm.
_npm__config_kv() {
  local k
  local -a keys
  if compset -P '*='; then
    _npm__config_value "${IPREFIX%=}"
    return
  fi
  for k in $_npm_config_keys; do
    (( ${_npm_deprecated_keys[(Ie)${k%%:*}]} )) || keys+=( "$k" )
  done
  _describe -t config-keys 'config key' keys -qS=
}

# -----------------------------------------------------------------------------
# Fixed value sets.
# -----------------------------------------------------------------------------

_npm__versions() {
  local -a v
  v=(
    'major:bump the major version'
    'minor:bump the minor version'
    'patch:bump the patch version'
    'premajor:bump to a prerelease of the next major'
    'preminor:bump to a prerelease of the next minor'
    'prepatch:bump to a prerelease of the next patch'
    'prerelease:bump the prerelease number'
    'from-git:use the latest git tag'
  )
  _describe -t versions 'new version (or an explicit semver)' v
}

_npm__doctor_checks() {
  local -a v
  v=(
    'connection:check the connection to the registry'
    'registry:check the registry configuration'
    'versions:check node and npm versions'
    'environment:check git and PATH'
    'permissions:check permissions of the cache and install folders'
    'cache:verify the cache'
    'ping:(hidden) same group as connection'
  )
  _describe -t checks 'doctor check' v
}

_npm__access_settings() {
  local -a v
  v=(
    'status=public:make the package public'
    'status=private:make the package private'
    'mfa=none:require no two-factor authentication to publish'
    'mfa=publish:require two-factor authentication to publish'
    'mfa=automation:require two-factor authentication or an automation token'
    '2fa=none:(hidden) same as mfa=none'
    '2fa=publish:(hidden) same as mfa=publish'
    '2fa=automation:(hidden) same as mfa=automation'
  )
  _describe -t settings 'access setting' v
}

_npm__profile_keys() {
  local expl
  local -a keys
  if [[ $1 == set ]]; then
    keys=( email password fullname homepage freenode twitter github )
  else
    keys=( name email 'two-factor auth' fullname homepage freenode twitter github created updated )
  fi
  _wanted keys expl 'profile property' compadd -a - keys
}

_npm__access_list_kinds() {
  local -a v
  v=(
    'packages:packages a user, scope or team can access'
    'collaborators:users with access to a package'
  )
  _describe -t kinds 'what to list' v
}

_npm__cache_npx_actions() {
  local -a v
  v=(
    'ls:list the npx cache'
    'rm:remove npx cache entries'
    'info:show npx cache entries'
  )
  _describe -t actions 'npx cache action' v
}

# -----------------------------------------------------------------------------
# Command handlers.
# -----------------------------------------------------------------------------

# Commands whose first argument is an action handled by their exec() switch.
_npm__with_subcommands() {
  local cmd=$1 curcontext=$curcontext state state_descr line ret=1
  local -A opt_args
  local -a reply
  _npm__option_specs "$cmd"
  _arguments -C -s -S : "${reply[@]}" "(-)1:subcommand: _npm__subcommands $cmd" '(-)*::arg:->args' && ret=0
  [[ $state == args ]] || return ret

  local sub=$words[1]
  curcontext="${curcontext%:*}-$sub:"
  case $cmd:$sub in
    (access:list)
      _npm__args access '1:what: _npm__access_list_kinds' '2:user, scope, scope\:team or package:' '3:package or user:' ;;
    (access:get) _npm__args access '1:property:(status)' '2:package:' ;;
    (access:set) _npm__args access '1:setting: _npm__access_settings' '2:package:' ;;
    (access:grant) _npm__args access '1:permission:(read-only read-write)' '2:scope\:team:' '3:package:' ;;
    (access:revoke) _npm__args access '1:scope\:team:' '2:package:' ;;

    (cache:add) _npm__args cache '*:package spec:' ;;
    (cache:(clean|rm|clear)) _npm__args cache '*:cache key:' ;;
    (cache:ls) _npm__args cache '*:name@version:' ;;
    (cache:(verify|check)) _npm__args cache ;;
    (cache:npx) _npm__args cache '1:action: _npm__cache_npx_actions' '*:npx cache key:' ;;

    (config:set) _npm__args config '*:key=value: _npm__config_kv' ;;
    (config:(get|delete|rm|del)) _npm__args config '*:config key: _npm__config_keys' ;;
    (config:(list|ls|edit|fix)) _npm__args config ;;

    (dist-tag:(add|a|set|s)) _npm__args dist-tag '1:package spec (with version):' '2:tag:' ;;
    (dist-tag:(rm|r|del|d|remove)) _npm__args dist-tag '1:package spec:' '2:tag:' ;;
    (dist-tag:(ls|l|sl|list)) _npm__args dist-tag '1:package spec:' ;;

    (install-scripts:(approve|deny)) _npm__args install-scripts '*:package: _npm__installed' ;;
    (install-scripts:(ls|list|prune)) _npm__args install-scripts ;;

    (org:(set|add)) _npm__args org '1:org name:' '2:username:' '3:role:(developer admin owner)' ;;
    (org:(rm|ls)) _npm__args org '1:org name:' '2:username:' ;;

    (owner:(add|rm|remove)) _npm__args owner '1:user:' '2:package spec:' ;;
    (owner:(ls|list)) _npm__args owner '1:package spec:' ;;

    (pkg:(get|delete)) _npm__args pkg '*:field: _npm__pkg_fields' ;;
    (pkg:set) _npm__args pkg '*:field=value: _npm__pkg_kv' ;;
    (pkg:fix) _npm__args pkg ;;

    (profile:(enable-2fa|enable-tfa|enable2fa|enabletfa))
      _npm__args profile '1:mode:(auth-only auth-and-writes)' ;;
    (profile:(disable-2fa|disable-tfa|disable2fa|disabletfa)) _npm__args profile ;;
    (profile:get) _npm__args profile '1:property: _npm__profile_keys get' ;;
    (profile:set) _npm__args profile '1:property: _npm__profile_keys set' '2:value:' ;;

    (team:(create|destroy)) _npm__args team '1:scope\:team:' ;;
    (team:(add|rm)) _npm__args team '1:scope\:team:' '2:user:' ;;
    (team:ls) _npm__args team '1:scope or scope\:team:' ;;

    (token:(revoke|rm|delete|remove)) _npm__args token '*:token id or token:' ;;
    (token:(list|ls|create)) _npm__args token ;;

    (stage:publish) _npm__args stage:publish '1:package spec:_files' ;;
    (stage:list) _npm__args stage:list '1:package spec:' ;;
    (stage:(view|approve|reject|download)) _npm__args stage:$sub '1:stage id:' ;;

    (trust:(github|gitlab|circleci|list|revoke)) _npm__args trust:$sub '1:package:' ;;

    (*) _message "unknown npm $cmd subcommand: $sub" ;;
  esac
}

_npm__dispatch() {
  local cmd=$1
  case $cmd in
    (access|cache|config|dist-tag|install-scripts|org|owner|pkg|profile|stage|team|token|trust)
      _npm__with_subcommands $cmd ;;
    (audit) _npm__args audit '1:subcommand: _npm__subcommands audit' ;;
    (approve-scripts|deny-scripts) _npm__args $cmd '*:package: _npm__installed' ;;
    (bugs|docs|repo) _npm__args $cmd '*:package name: _npm__installed' ;;
    (deprecate) _npm__args $cmd '1:package spec:' '2:message:' ;;
    (undeprecate|unpublish) _npm__args $cmd '1:package spec:' ;;
    (diff) _npm__args $cmd '*:path:_files' ;;
    (doctor) _npm__args $cmd '*:check: _npm__doctor_checks' ;;
    (edit|explore) _npm__args $cmd '1:package: _npm__installed' ;;
    (exec) _npm__args $cmd '1:command: _npm__bins' '*::argument:_normal' ;;
    (explain|fund|ll|ls|outdated|prune|rebuild|uninstall|update)
      _npm__args $cmd '*:package: _npm__installed' ;;
    (get) _npm__args $cmd '*:config key: _npm__config_keys' ;;
    (set) _npm__args $cmd '*:key=value: _npm__config_kv' ;;
    (help) _npm__args $cmd '1:help topic: _npm__help_topics' '*:term:' ;;
    (help-search|search) _npm__args $cmd '*:search term:' ;;
    (init) _npm__args $cmd '1:initializer (package spec or @scope):' ;;
    (install|install-test) _npm__args $cmd '*:package spec: _npm__package_specs' ;;
    (link) _npm__args $cmd '1:package: _npm__link_targets' ;;
    (pack|publish) _npm__args $cmd '*:package spec or folder:_files' ;;
    (query) _npm__args $cmd '1:selector:' ;;
    (restart|start|stop|test) _npm__args $cmd '*:argument:_files' ;;
    (run) _npm__args $cmd '1:script: _npm__scripts' '*:argument:_files' ;;
    (star|unstar) _npm__args $cmd '*:package spec:' ;;
    (stars) _npm__args $cmd '1:user:' ;;
    (version) _npm__args $cmd '1:new version: _npm__versions' ;;
    (view) _npm__args $cmd '1:package spec:' '*:field:' ;;
    (*) _npm__args $cmd ;;
  esac
}

function _npm() {
  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args
  local -a reply _npm_line_words
  _npm_line_words=( "${words[@]}" )

  # `(-)` stops this call from claiming options after the command name: every
  # config option is also a root option, and `npm uninstall -g <TAB>` would
  # otherwise leave the command handler with only the current word.
  _npm__option_specs ''
  _arguments -C -s -S : "${reply[@]}" '(-)1: : _npm__commands' '(-)*::arg:->args' && ret=0

  case $state in
    (args)
      local REPLY
      if _npm__deref "$words[1]"; then
        curcontext="${curcontext%:*:*}:npm-$REPLY:"
        _npm__dispatch "$REPLY" && ret=0
      else
        _message "unknown npm command: $words[1]"
      fi
      ;;
  esac

  return ret
}

_npm "$@"

