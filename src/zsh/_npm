# -----------------------------------------------------------------------------
# Small JavaScript readers run with the user's node: npm itself needs node, and
# one node start (~40 ms) is far cheaper than one npm start (~250 ms).
# -----------------------------------------------------------------------------

# Scripts of a package.json, as `name:command` lines.
typeset -g _npm_js_scripts='try{const s=require(process.argv[1]).scripts||{};for(const[k,v]of Object.entries(s))console.log(k.replace(/:/g,"\\:")+":"+String(v).replace(/\s+/g," ").slice(0,80))}catch{}'

# Top-level fields of a package.json.
typeset -g _npm_js_fields='try{for(const k of Object.keys(require(process.argv[1])))console.log(k.replace(/:/g,"\\:"))}catch{}'

# Workspaces of the nearest package.json (walking up) that declares any, as
# `name:path` lines.
typeset -g _npm_js_workspaces='try{const fs=require("fs"),p=require("path");let d=process.argv[1],ws;for(;;){try{ws=require(p.join(d,"package.json")).workspaces}catch{}if(ws)break;const u=p.dirname(d);if(u===d)process.exit(0);d=u}const pats=Array.isArray(ws)?ws:ws.packages||[];for(const pat of pats)for(const m of fs.globSync(pat,{cwd:d})){try{const n=require(p.join(d,m,"package.json")).name;console.log((n||m).replace(/:/g,"\\:")+":"+m)}catch{}}}catch{}'

# Local interface addresses, the same source npm validates --local-address with.
typeset -g _npm_js_addresses='for(const[n,a]of Object.entries(require("os").networkInterfaces()))for(const i of a)console.log(i.address.replace(/:/g,"\\:")+":"+n+" "+i.family)'

