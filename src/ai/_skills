# 1.7.4 (skills)
#
# `skills` and `add-skill` are two names for the same entry point and ignore
# argv[0], so their command surface is identical.  src/ai/_add-skill delegates
# here.
#
# Items marked "(hidden)" are accepted by the CLI but never printed by
# `skills --help`; each was confirmed against the 1.7.4 binary:
#
#   * command aliases `install` and `i` (add), `r` (remove), `search`, `f`
#     and `s` (find), and `check` (update).
#   * `experimental_install` flags `--copy`, `--dry-run`, `--no-cleanup`,
#     `--no-remote`, `-r/--recursive`, `--include` and `--exclude`.  The
#     command hands its arguments to the `experimental_sync` parser, so these
#     act on the node_modules entries of skills-lock.json.  `-a` and `-y` are
#     parsed there too but always overridden, so they are not offered.
#
# Not offered because the binary no longer accepts them:
#
#   * `use --dangerously-accept-openclaw-risks` - "Unknown option" since the
#     OpenClaw gate was removed.
#   * `experimental_sync -f/--force` - no longer parsed anywhere.
#
# `remove -a/--agent` and `list -a/--agent` still reject '*' ("Invalid
# agents: *", exit 1); only `add` and `experimental_sync` expand it.
#
# -----------------------------------------------------------------------------

_skills__message() {
  _message "${1:-value}"
}

