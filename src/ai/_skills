# 1.5.22 (skills)
#
# `skills` and `add-skill` are two names for the same entry point: package.json
# maps both to bin/cli.mjs and src/cli.ts never inspects argv[0], so the command
# surface is identical.  src/ai/_add-skill delegates here.
#
# Items marked "(hidden)" are dispatched by the switch in src/cli.ts, or accepted
# by a per-command argv parser, but never printed by `skills --help`.
#
# Two options are documented in `--help` yet do not behave as documented; both
# are marked in place and were confirmed against the 1.5.22 binary:
#
#   * `remove -s/--skill` - parseRemoveOptions() has no branch for it and
#     RemoveOptions carries no `skill` field, so the flag is dropped and its
#     value is read as a positional skill name.  `skills remove --skill '*'`
#     reports "No matching skills found for: *".
#   * `remove -a/--agent '*'` and `list -a/--agent '*'` - both validate against
#     Object.keys(agents) with no wildcard branch, so '*' exits 1 with
#     "Invalid agents: *".  Only `add` and `experimental_sync` expand '*'.
#
# -----------------------------------------------------------------------------

_skills__message() {
  _message "${1:-value}"
}

