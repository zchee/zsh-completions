# Agent names only.  `list` and `remove` reject a wildcard, so '*' is
# deliberately absent here.
_skills__agents() {
  local -a agent_list
  _skills__agent_list
  _describe -t agents 'agent' agent_list
}

# Agent names plus '*'.  Only `add` and `experimental_sync` expand '*' to the
# full registry.
_skills__agents_all() {
  local -a agent_list wildcard
  local ret=1
  wildcard=( '*:every agent in the registry' )
  _skills__agent_list
  _describe -t wildcards 'agent selector' wildcard && ret=0
  _describe -t agents 'agent' agent_list && ret=0
  return ret
}

# `skills use --agent` starts the agent interactively, so it accepts only the
# agents it knows how to launch.  Any other registry name parses but aborts
# with "does not support".
_skills__use_agents() {
  local -a use_agents
  use_agents=(
    'claude-code:Claude Code (spawns claude)'
    'codex:Codex (spawns codex)'
    'sarvam-code:Sarvam Code (spawns sarvam-code)'
  )
  _describe -t agents 'supported agent' use_agents
}

# Eve subagents live in agent/subagents/<name>/skills; 'root' and '.' both
# select the root agent.
_skills__subagents() {
  local -a subagent_list special
  local ret=1
  special=(
    'root:the Eve root agent (agent/skills)'
    '.:the Eve root agent (agent/skills)'
  )
  subagent_list=( agent/subagents/*(/N:t) )
  _describe -t special 'root selector' special && ret=0
  if (( ${#subagent_list} )); then
    local -a expl
    _wanted subagents expl 'Eve subagent' compadd -a subagent_list && ret=0
  fi
  (( ret )) && _skills__message 'Eve subagent name'
  return ret
}

# Skill selector for `add --skill` / `add --all`.  Which skills exist depends on
# the remote repository, which cannot be enumerated offline, so only the
# wildcard is offered.
_skills__skill_filter() {
  local -a wildcard
  local ret=1
  wildcard=( '*:every skill in the repository' )
  _describe -t wildcards 'skill selector' wildcard && ret=0
  (( ret )) && _skills__message 'skill name'
  return ret
}

# Installed skill names for `remove` and `update`.  `skills list --json` runs
# the same scan those commands perform and records no telemetry event, but
# DO_NOT_TRACK is set anyway so completion can never emit one.
#
# $1 is the scope to use when the line carries no scope flag: `project` for
# remove, which defaults to the project scope, or `both` for update, which
# checks global and project when neither -g nor -p is given.
#
# With $2 set to `remove`, the values `remove` also accepts are offered: '*'
# selects every skill, and an exact lock source removes every skill installed
# from it.  `list --json` prints the same resolved source string that `remove`
# matches against.
_skills__installed_skills() {
  local fallback=${1:-project} mode=$2 scope out ret=1
  local -a scopes names sources wildcard expl

  if (( ${+opt_args[-g]} || ${+opt_args[--global]} )); then
    scopes=( '-g' )
  elif (( ${+opt_args[-p]} || ${+opt_args[--project]} )); then
    scopes=( '' )
  elif [[ $fallback == both ]]; then
    scopes=( '' '-g' )
  else
    scopes=( '' )
  fi

  for scope in "${scopes[@]}"; do
    out=$(_call_program installed-skills \
      "DO_NOT_TRACK=1 ${(q)service} list $scope --json" 2>/dev/null)
    names+=( ${(f)"$(print -r -- $out | sed -n 's/^ *"name": "\(.*\)",$/\1/p')"} )
    [[ $mode == remove ]] &&
      sources+=( ${(f)"$(print -r -- $out | sed -n 's/^ *"source": "\(.*\)",$/\1/p')"} )
  done
  names=( ${(u)names} )
  sources=( ${(u)sources} )

  if [[ $mode == remove ]]; then
    wildcard=( '*:every installed skill' )
    _describe -t wildcards 'skill selector' wildcard && ret=0
  fi

  # Plugin skills keep a ':' in their name, and sources are often URLs, which
  # _describe would read as a description separator, so add them with compadd.
  (( ${#names} )) &&
    _wanted skills expl 'installed skill' compadd -a names && ret=0
  (( ${#sources} )) &&
    _wanted sources expl 'lock source (removes every skill from it)' compadd -a sources && ret=0

  (( ret )) && _skills__message 'installed skill name'
  return ret
}

# Patterns for `experimental_sync --include/--exclude`: a glob over the names
# of the project's direct dependencies, optionally narrowed to one skill with
# `<pkg>#<skill>`.  Both halves are read from disk without running anything.
_skills__sync_patterns() {
  local json field entry pkg
  local -a pkgs skills expl

  if compset -P '*\#'; then
    pkg=${IPREFIX%\#}
    skills=( node_modules/$pkg/{skills,dist/skills}/*/SKILL.md(N:h:t) )
    if (( ${#skills} )); then
      _wanted skills expl "skill shipped by $pkg" compadd -a skills
    else
      _skills__message "skill name shipped by $pkg"
    fi
    return
  fi

  [[ -r package.json ]] && json=$(<package.json)
  for field in dependencies devDependencies optionalDependencies peerDependencies; do
    [[ $json =~ "\"$field\"[[:space:]]*:[[:space:]]*\\{([^}]*)\\}" ]] || continue
    for entry in "${(@s:,:)match[1]}"; do
      [[ $entry =~ '"([^"]+)"[[:space:]]*:' ]] && pkgs+=( $match[1] )
    done
  done
  pkgs=( ${(u)pkgs} )

  if (( ${#pkgs} )); then
    _wanted packages expl 'dependency (append #skill for one skill)' \
      compadd -q -S ' ' -r '#' -a pkgs
  else
    _skills__message '<pkg> or <pkg>#<skill> glob'
  fi
}

# A package source for `add` / `use`.
_skills__source() {
  local -a prefixes known
  local ret=1

  if [[ $PREFIX == (git@*|ssh://*|http://*|https://*) ]]; then
    _skills__message 'repository, archive, or .well-known URL'
    return
  fi
  # The selector after '@' is resolved against the remote repository.
  if compset -P '*@'; then
    _skills__message 'skill name'
    return
  fi
  if compset -P '(github|gitlab):'; then
    _skills__message 'owner/repo[/subpath][#ref][@skill]'
    return
  fi
  if [[ $PREFIX == [./]* ]]; then
    _files
    return
  fi

  prefixes=(
    'github\::GitHub shorthand, github:owner/repo'
    'gitlab\::GitLab shorthand, gitlab:owner/repo'
  )
  # The recognised source aliases, plus the canonical target.
  known=(
    'notion:skills from the connected Notion workspace (or a notion.so page URL)'
    'vercel-labs/agent-skills:the Vercel agent skills collection'
    'vercel-labs/vercel-skills:alias for vercel-labs/agent-skills'
    'coinbase/agentWallet:alias for coinbase/agentic-wallet-skills'
  )

  _describe -t prefixes 'source prefix' prefixes -S '' && ret=0
  _describe -t sources 'known source' known && ret=0
  (( ret )) && _skills__message 'owner/repo[#ref][@skill], URL, or ./local/path'
  return ret
}

# Replay a per-command argv scan over the words already on the line, so the
# completion agrees with the CLI about what the current word is.
#
# `add`, `remove`, `list` and `sync` treat -a/-s/--subagent as "keep swallowing
# words until one starts with '-'", so a bare word after one of them is another
# list value and not a positional.
#
# $1 is a space separated list of those multi-value flags, $2 of the flags that
# take exactly one value.  Sets REPLY to the flag still consuming words (empty
# when the current word is a positional) and _skills_nargs to the number of
# positionals already seen.
_skills__scan() {
  local -a multi single
  local w mode=''
  integer i pending_single=0

  multi=( ${=1} )
  single=( ${=2} )
  _skills_nargs=0

  # (Ie) is an exact-string membership test; plain (I) would treat a word such
  # as `-*` on the line as a pattern and match the wrong flag.
  for (( i = 2; i < CURRENT; i++ )); do
    w=${words[i]}
    if [[ $w == -* ]]; then
      mode=''
      pending_single=0
      (( ${multi[(Ie)$w]} )) && mode=$w
      (( ${single[(Ie)$w]} )) && { mode=$w; pending_single=1 }
    elif [[ -n $mode ]]; then
      (( pending_single )) && { mode=''; pending_single=0 }
    else
      (( _skills_nargs++ ))
    fi
  done

  REPLY=$mode
}

_skills__commands() {
  local -a commands
  commands=(
    'add:add a skill package'
    'a:add a skill package (documented alias for add)'
    'install:(hidden) alias for add'
    'i:(hidden) alias for add'
    'use:generate a prompt for one skill without installing it'
    'remove:remove installed skills'
    'rm:remove installed skills (alias for remove)'
    'r:(hidden) alias for remove'
    'list:list installed skills'
    'ls:list installed skills (alias for list)'
    'find:search for skills interactively'
    'search:(hidden) alias for find'
    'f:(hidden) alias for find'
    's:(hidden) alias for find'
    'update:update skills to latest versions'
    'upgrade:update skills to latest versions (documented alias for update)'
    'check:(hidden) alias for update'
    'experimental_install:restore skills from skills-lock.json'
    'init:initialize a skill, creating <name>/SKILL.md or ./SKILL.md'
    'experimental_sync:sync skills from node_modules into agent directories'
    'sync:sync skills from node_modules (documented alias for experimental_sync)'
  )
  _describe -t commands 'command' commands
}

# `add` reads only the first bare word, and -a/-s/--subagent keep swallowing
# bare words, so a source must be given before any of those flags.
_skills__add_rest() {
  local REPLY
  integer _skills_nargs

  _skills__scan '-a --agent -s --skill --subagent' '--metadata'
  case $REPLY in
    -a|--agent) _skills__agents_all; return ;;
    -s|--skill) _skills__skill_filter; return ;;
    --subagent) _skills__subagents; return ;;
  esac

  (( _skills_nargs > 0 )) && {
    _skills__message 'ignored: add reads only the first source'
    return 1
  }
  _skills__source
}

_skills__add() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '(-g --global)'{-g,--global}'[install globally (user-level) instead of project-level]' \
    '(-y --yes)'{-y,--yes}'[skip confirmation prompts]' \
    '(-l --list)'{-l,--list}'[list available skills in the repository without installing]' \
    '*'{-a,--agent}'[agents to install to]:agent: _skills__agents_all' \
    '*'{-s,--skill}'[skill names to install]:skill: _skills__skill_filter' \
    '*--subagent[install to Eve subagents]:subagent: _skills__subagents' \
    '--metadata[attach valid JSON to the install telemetry event]:json: _skills__message "JSON object"' \
    '--copy[copy files instead of symlinking to agent directories]' \
    '--all[shorthand for --skill * --agent * -y]' \
    '--full-depth[search all subdirectories even when a root SKILL.md exists]' \
    '--json[output results as JSON (machine-readable, no ANSI codes)]' \
    '*:source: _skills__add_rest'
}

# `use` rejects a second source and a second --skill/--agent value, so there is
# nothing to complete past the first of each.
_skills__use() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '(-s --skill)'{-s,--skill}'[skill to use]:skill: _skills__message "skill name"' \
    '(-a --agent)'{-a,--agent}'[start one supported agent interactively]:agent: _skills__use_agents' \
    '--full-depth[search all subdirectories even when a root SKILL.md exists]' \
    '1:source: _skills__source'
}

# -s/--skill and bare words feed the same list, and both -a and -s keep
# swallowing bare words, so the scan decides which list the current word
# belongs to.
_skills__remove_rest() {
  local REPLY
  integer _skills_nargs

  _skills__scan '-a --agent -s --skill' ''
  [[ $REPLY == (-a|--agent) ]] && { _skills__agents; return }
  _skills__installed_skills project remove
}

# `--all` implies -y and exits 1 when combined with named skills.
_skills__remove() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '(-g --global)'{-g,--global}'[remove from the global scope instead of the project scope]' \
    '(-y --yes)'{-y,--yes}'[skip confirmation prompts]' \
    '(-y --yes -s --skill *)--all[remove every installed skill (implies -y; refuses named skills)]' \
    "*"{-a,--agent}"[remove from specific agents; omit to clean all agent links (rejects '*', unlike add)]:agent: _skills__agents" \
    '(--all)*'{-s,--skill}"[skills to remove ('*' for all, or a lock source)]:skill: _skills__installed_skills project remove" \
    '(--all)*:skill: _skills__remove_rest'
}

# `list` discards bare words, so nothing but an agent list can follow the flags.
_skills__list_rest() {
  local REPLY
  integer _skills_nargs

  _skills__scan '-a --agent' ''
  [[ $REPLY == (-a|--agent) ]] && { _skills__agents; return }
  _skills__message 'ignored: skills list takes no positional arguments'
  return 1
}

_skills__list() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '(-g --global)'{-g,--global}'[list global skills (default: project)]' \
    '--json[output as JSON (machine-readable, no ANSI codes)]' \
    "*"{-a,--agent}"[filter by specific agents (rejects '*', unlike add)]:agent: _skills__agents" \
    '*:argument: _skills__list_rest'
}

# `find` joins every bare word into one query string.
_skills__find() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '--owner=[search only repositories from a GitHub owner]:owner: _skills__message "GitHub owner"' \
    '*:query: _skills__message "search query"'
}

# -g and -p are not exclusive: given together they select the 'both' scope.
_skills__update() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '(-g --global)'{-g,--global}'[update global skills only]' \
    '(-p --project)'{-p,--project}'[update project skills only]' \
    '(-y --yes)'{-y,--yes}'[skip the scope prompt and auto-detect the scope]' \
    '*:skill: _skills__installed_skills both'
}

# `init` reads only the first bare word.
_skills__init() {
  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '1:name: _skills__message "skill name (default: the current directory name)"' \
    '*:argument: _skills__message "ignored: only the first name is read"'
}

# Neither command reads positional arguments.  -a, --include and --exclude
# keep swallowing bare words, so the scan decides which list the current word
# belongs to.  $1 is the command name for the message.
_skills__sync_rest() {
  local REPLY
  integer _skills_nargs

  _skills__scan '-a --agent --include --exclude' ''
  case $REPLY in
    -a|--agent)          _skills__agents_all; return ;;
    --include|--exclude) _skills__sync_patterns; return ;;
  esac
  _skills__message "ignored: $1 takes no positional arguments"
  return 1
}

# `experimental_install` hands its arguments to the experimental_sync parser
# for the node_modules entries of skills-lock.json.  That parser's -a and -y
# are overridden by the caller, so only the remaining sync flags are offered.
_skills__experimental_install() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    "${(@)sync_flags/\[/[(hidden) }" \
    '*:argument: _skills__sync_rest experimental_install'
}

_skills__experimental_sync() {
  local -A opt_args

  _arguments -C : \
    '(- *)'{-h,--help}'[show help]' \
    '(-y --yes)'{-y,--yes}'[skip confirmation prompts]' \
    '*'{-a,--agent}"[agents to install to ('*' for all)]:agent: _skills__agents_all" \
    "${sync_flags[@]}" \
    '*:argument: _skills__sync_rest experimental_sync'
}

_skills() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  # Shared by experimental_sync and experimental_install, which both run the
  # experimental_sync argv parser.
  local -a sync_flags
  sync_flags=(
    '--copy[copy skills instead of linking them to node_modules]'
    '--dry-run[show what would change without changing anything]'
    '--no-cleanup[keep skills whose package no longer ships them]'
    '--no-remote[skip git sources listed in package.json skills fields]'
    '(-r --recursive)'{-r,--recursive}'[also sync the dependencies of each workspace package]'
    '*--include[only sync matching packages (<pkg>) or skills (<pkg>#<skill>)]:pattern: _skills__sync_patterns'
    '*--exclude[skip matching packages (<pkg>) or skills (<pkg>#<skill>)]:pattern: _skills__sync_patterns'
  )

  # No -s: every argv parser compares whole words, so short options do not
  # stack.  No -S either: '--' is not a recognised separator.
  _arguments -C : \
    '(- *)'{-h,--help}'[show this help message]' \
    '(- *)'{-v,--version}'[show version number]' \
    '1:command:->command' \
    '*::arg:->args' && ret=0

  case $state in
    command)
      _skills__commands && ret=0
      ;;
    args)
      curcontext="${curcontext%:*:*}:${service}-${words[1]}:"
      case ${words[1]} in
        add|a|install|i)        _skills__add && ret=0 ;;
        use)                    _skills__use && ret=0 ;;
        remove|rm|r)            _skills__remove && ret=0 ;;
        list|ls)                _skills__list && ret=0 ;;
        find|search|f|s)        _skills__find && ret=0 ;;
        update|upgrade|check)   _skills__update && ret=0 ;;
        init)                   _skills__init && ret=0 ;;
        experimental_install)   _skills__experimental_install && ret=0 ;;
        experimental_sync|sync) _skills__experimental_sync && ret=0 ;;
      esac
      ;;
  esac

  return ret
}

_skills "$@"

