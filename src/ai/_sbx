        "list:(alias of ls)"
        "remove:(alias of rm)"
        "secrets:(alias of secret)"
      )
      _describe -t commands "sbx command" commands && ret=0
      ;;
    args)
      case $words[1] in
        attach)
          _sbx__attach && ret=0
          ;;
        completion)
