# sbx (Docker Sandboxes) v0.42.0-rc1-175-g732ea0916
#   Homebrew cask sbx@nightly, build nightly-202608311035-732ea09
#
# Derived from `sbx <path> --help` over all 106 documented command paths, then
# extended with the surface the help output suppresses. sbx is a Cobra CLI
# (spf13/cobra 1.10.2) built with a stripped symbol table, so the hidden items
# were recovered from the Go pclntab: every `cli-plugin/commands` constructor
# was disassembled for its string literals, and each candidate was then
# confirmed against the binary itself
# (`sbx <path> --zz-not-a-flag` answers "unknown flag" for a registered path
# and "unknown command" for anything else; a sentinel control rules out the
# commands that merely take positional arguments).
#
# Items marked "(hidden)" are accepted by the binary but never listed by
# `--help`:
#
#   * commands:  events, gui (+ status), settings (+ get/list/set/unset),
#                ssh (+ setup, setup remove, known-hosts, proxy), ssh-connect,
#                inspect, mount, umount, docker-cli-plugin-metadata,
#                __complete, __completeNoDesc, daemon inspect,
#                policy init set-default
#   * flags:     --app-name (root, marked hidden);
#                create/run/create <agent>: --branch, --no-share-skills,
#                --secrets, --pull, and run's --detached/--patch-settings;
#                create <agent>: --patch-settings;
#                secret ls/rm: --host, --env, --placeholder;
#                secret rm/set/set-custom: --global (deprecated, so hidden);
#                secret set/set-custom: --backend
#   * gated:     --display, --nested, --gpu, --usb (create/run) and run's
#                --model are registered behind the feature flags
#                feature.sandbox-{display,nested,gpu,usb} / feature.model, so
#                they parse but only act when the feature is on
#
# `ssh` and its subcommands sit behind feature.ssh, and the whole subtree is
# hidden. Aliases (ls/list, rm/remove/delete, secret rm unset, skills add a,
# skills update upgrade, volume inspect get, create docker-agent cagent) are
# completed too; Cobra lists them only in the aliased command's own --help.
#
# Values for positional arguments come from the binary's own completion
# endpoint (`sbx __complete ...`), which resolves sandbox names, MCP servers,
# secret services, settings keys, templates, volumes and policy profiles.
#
# -----------------------------------------------------------------------------

(( $+functions[_sbx__dyn] )) || _sbx__dyn() {
  local tag=${1:-value} line value description
  local -a request lines values
  request=( ${_sbx_words[2,$(( _sbx_cur - 1 ))]} "" )
  lines=( ${(f)"$(_call_program sbx-complete ${(q)_sbx_prog} __complete ${(q)request} 2>/dev/null)"} )
  for line in $lines; do
    [[ -z $line || $line == :* || $line == 'Completion ended'* || $line == -* ]] && continue
    value=${line%%$'\t'*}
    description=${line#*$'\t'}
    [[ -n $value ]] || continue
    if [[ $description == $value ]]; then
      values+=( "${value//:/\\:}" )
    else
      values+=( "${value//:/\\:}:${description}" )
    fi
  done
  (( $#values )) || return 1
  _describe -t sbx-values $tag values
}

function _sbx() {
  local context curcontext=$curcontext state line expl ret=1
  typeset -A opt_args
  local -a _sbx_words=( "${words[@]}" )
  local _sbx_cur=$CURRENT _sbx_prog=${words[1]}

  local -a global_opts
  global_opts=(
    "(--cloud)--cloud[Dispatch to Docker Cloud Sandboxes API instead of local sandboxd (supported by a growing set of verbs — run 'sbx...]"
    "(--cloud-api-url)--cloud-api-url=[Cloud Sandboxes API base URL; only used with --cloud. Defaults to prod (https://api.sandboxes-cloud.docker.com). Set...]:cloud-api-url:"
    "(-D --debug)"{-D,--debug}"[Enable debug logging]"
    "(- : *)"{-h,--help}"[Show help for the command]"
    "(--app-name)--app-name=[(hidden) Storagekit application name for isolated daemon instance (for development/debugging)]:app-name:"
  )

  _arguments -C -s -S \
    $global_opts \
    "1: :->command" \
    "*:: :->args" && ret=0

  case $state in
    command)
      local -a commands
      commands=(
        "attach:Attach to a running cloud sandbox"
        "completion:Generate the autocompletion script for the specified shell"
        "cp:Copy files or directories between a sandbox and the host"
        "create:Create a sandbox for an agent"
        "daemon:Manage sandboxd daemon"
        "diagnose:Diagnose common issues with your sbx installation"
        "env:(Experimental) Manage sandboxes declaratively from an sbxenv.yaml file"
        "exec:Execute a command inside a sandbox"
        "help:Help about any command"
        "kit:(Experimental) Manage kit artifacts"
        "login:Sign in to Docker"
        "logout:Stop all running sandboxes and sign out of Docker"
        "ls:List sandboxes"
        "mcp:Manage MCP servers"
        "move:Move a sandbox between local and cloud"
        "policy:Manage sandbox policies"
        "ports:Manage sandbox port publishing"
        "prune:Remove all stopped sandboxes"
        "reset:Reset all sandboxes and clean up state"
        "rm:Remove one or more sandboxes"
        "run:Run an agent in a sandbox"
        "secret:Manage stored secrets"
        "setup:(Experimental) Detect host configuration and prepare Docker Sandboxes"
        "skills:(Experimental) Manage skills available in sandboxes"
        "stop:Stop one or more sandboxes without removing them"
        "template:Manage sandbox templates"
        "ttl:Inspect or extend a cloud sandbox's TTL"
        "tui:Open the interactive TUI dashboard"
        "version:Show Docker Sandboxes version information"
        "volume:Manage persistent volumes (cloud-only)"
        "events:(hidden) Stream sandbox events from the daemon"
        "gui:(hidden) Manage GUI systray app"
        "settings:(hidden) Manage Docker Sandboxes settings"
        "ssh:(hidden) Configure SSH access to sandboxes (experimental)"
        "ssh-connect:(hidden) Internal ProxyCommand helper: mint a cert if needed and pipe to the gateway"
        "inspect:(hidden) Show details for a sandbox"
        "mount:(hidden) Bind-mount a host path into a running sandbox at runtime"
        "umount:(hidden) Revoke a previously-exposed host path"
        "docker-cli-plugin-metadata:(hidden) Print the Docker CLI plugin metadata JSON"
        "__complete:(hidden) Cobra completion endpoint used by generated shell scripts"
        "__completeNoDesc:(hidden) Cobra completion endpoint without descriptions"
        "delete:(alias of rm)"
        "list:(alias of ls)"
        "remove:(alias of rm)"
      )
      _describe -t commands "sbx command" commands && ret=0
      ;;
    args)
      case $words[1] in
        __complete)
          _message "cobra completion endpoint"
          ;;
        __completeNoDesc)
          _message "cobra completion endpoint"
          ;;
        attach)
          _sbx__attach && ret=0
          ;;
        completion)
          _sbx__completion && ret=0
          ;;
        cp)
          _sbx__cp && ret=0
          ;;
        create)
          _sbx__create && ret=0
          ;;
        daemon)
          _sbx__daemon && ret=0
          ;;
        diagnose)
          _sbx__diagnose && ret=0
          ;;
        docker-cli-plugin-metadata)
          _sbx__docker_cli_plugin_metadata && ret=0
          ;;
        env)
          _sbx__env && ret=0
          ;;
        events)
          _sbx__events && ret=0
          ;;
        exec)
          _sbx__exec && ret=0
          ;;
        gui)
          _sbx__gui && ret=0
          ;;
        help)
          _sbx__dyn "command" && ret=0
          ;;
        inspect)
          _sbx__inspect && ret=0
          ;;
        kit)
          _sbx__kit && ret=0
          ;;
        login)
          _sbx__login && ret=0
          ;;
        logout)
          _sbx__logout && ret=0
          ;;
        list|ls)
          _sbx__ls && ret=0
          ;;
        mcp)
          _sbx__mcp && ret=0
          ;;
        mount)
          _sbx__mount && ret=0
          ;;
        move)
          _sbx__move && ret=0
          ;;
        policy)
          _sbx__policy && ret=0
          ;;
        ports)
          _sbx__ports && ret=0
          ;;
        prune)
          _sbx__prune && ret=0
          ;;
        reset)
          _sbx__reset && ret=0
          ;;
        delete|remove|rm)
          _sbx__rm && ret=0
          ;;
        run)
          _sbx__run && ret=0
          ;;
        secret)
          _sbx__secret && ret=0
          ;;
        settings)
          _sbx__settings && ret=0
          ;;
        setup)
          _sbx__setup && ret=0
          ;;
        skills)
          _sbx__skills && ret=0
          ;;
        ssh)
          _sbx__ssh && ret=0
          ;;
        ssh-connect)
          _sbx__ssh_connect && ret=0
          ;;
        stop)
          _sbx__stop && ret=0
          ;;
        template)
          _sbx__template && ret=0
          ;;
        ttl)
          _sbx__ttl && ret=0
          ;;
        tui)
          _sbx__tui && ret=0
          ;;
        umount)
          _sbx__umount && ret=0
          ;;
        version)
          _sbx__version && ret=0
          ;;
        volume)
          _sbx__volume && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

