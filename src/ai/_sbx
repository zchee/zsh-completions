#
# Derived from `sbx <path> --help` over all 124 documented command paths, then
# extended with the surface the help output suppresses; every added item was
# verified against sbx as shipped.
#
# Items marked "(hidden)" are accepted by sbx but never listed by `--help`:
#
#   * commands:  events, gui (+ status), inspect, mount, umount,
#                compose (+ up/down/pull/stop/metadata, the Docker Compose
#                provider entrypoint), ssh (+ setup, known-hosts, proxy),
#                ssh-connect, docker-cli-plugin-metadata, daemon inspect,
#                policy approval (+ inspect/ls/respond, feature-gated),
#                setup ssh-key (+ initialize/remove/rotate, feature-gated)
#   * flags:     --app-name, --ui-origin, --cloud-api-url (root, persistent);
#                create/run: --branch, --no-share-skills, --secrets;
#                run and create <agent>: --patch-settings;
#                run: --model, --provider, --overflow-provider,
#                --overflow-model, --variant (feature.model);
#                secret ls/rm: --host, --env-name, --placeholder;
#                secret set/set-custom: --backend;
#                daemon start: --launcher, --launch-deadline;
#                settings ls: --all
#   * deprecated (hidden, still parsed): -g/--global on secret rm/set/
#                set-custom and on policy allow|deny|rm network;
#                mcp add --skip_auth (use --skip-auth)
#   * gated:     --display, --nested, --4k, --gpu, --usb (create/run; env run
#                has --nested) are registered behind the feature flags
#                feature.sandbox-{display,nested,4k,gpu,usb}, so they parse
#                but only act when the feature is on
#
# Removed since v0.42: `ssh setup remove` (now the documented
# `setup ssh remove`), `policy init set-default`, run's --detached, and the
# hidden `--env` filter on secret ls/rm (renamed --env-name). `settings list`
# became an alias of the documented `settings ls`.
#
# Aliases (ls/list, rm/remove/delete, secret rm unset, skills add a,
# skills update upgrade, volume inspect get, create docker-agent cagent, and
# the rest sbx prints) are completed too; sbx lists them only in the aliased
# command's own --help.
#
# Values for positional arguments come from sbx's own completion endpoint
# (`sbx __complete ...`), which resolves sandbox names, MCP servers, secret
# services, settings keys, templates, volumes and policy profiles.
#
# The completion RPC itself -- `__complete` and `__completeNoDesc` -- is
# deliberately left out: it is plumbing for this file to call, not a command
# anyone types. `docker-cli-plugin-metadata` and `compose` are kept: they
# are host handshakes (docker/cli and Docker Compose), and both run by hand.
#
# -----------------------------------------------------------------------------

(( $+functions[_sbx__dyn] )) || _sbx__dyn() {
  local tag=${1:-value} line value description
  local -a request lines values
  request=( ${_sbx_words[2,$(( _sbx_cur - 1 ))]} "" )
  lines=( ${(f)"$(_call_program sbx-complete ${(q)_sbx_prog} __complete ${(q)request} 2>/dev/null)"} )
  for line in $lines; do
    [[ -z $line || $line == :* || $line == 'Completion ended'* || $line == -* ]] && continue
    value=${line%%$'\t'*}
    description=${line#*$'\t'}
    [[ -n $value ]] || continue
    if [[ $description == $value ]]; then
      values+=( "${value//:/\\:}" )
    else
      values+=( "${value//:/\\:}:${description}" )
    fi
  done
  (( $#values )) || return 1
  _describe -t sbx-values $tag values
}

