# 2.1.252 (Claude Code)
#
# The shipped binary is a Bun-compiled Commander.js program. The surface is
# recovered from the beautified bundle (`cli.unpack.js` in the claude-code
# reverse tree, whose package.json version must match `claude --version`) with
# a balanced-paren *method-chain* parser: locate `.name("claude")`,
# `.command()`, `.option()`, `.addOption()` and attribute each call to the
# chain that owns it. A regex over `new Option(...)...hideHelp()` greedily
# spans into the next option and mislabels visible flags, so it is not used.
# Three registration shapes need special handling: options built in a block
# (`let P = new O(...); P.hideHelp(); prog.addOption(P)` — `--messaging-socket-path`),
# options built by a factory (`let u = () => new O("--cowork", …).hideHelp()`,
# added via `.addOption(u())`), and subcommands registered inside helper
# functions whose first parameter is the parent command (`Br(mcpCmd, ctx)`
# registers `mcp add`). `attach`/`logs`/`stop`/`respawn`/`rm` come from a
# helper returning bare `new Command(...)` objects, not from `.command()`.
#
# Every item below was confirmed against the 2.1.252 binary. `--help` is not
# an oracle here: it short-circuits before option validation, so even a bogus
# flag prints usage. What works is `claude <FLAG> mcp list`, which answers
# `error: unknown option '<FLAG>'` for anything unregistered, and
# `claude <CMD> --help`, which falls back to root usage for an unknown command.
#
# Items marked "(hidden)" are accepted but suppressed from `--help`:
#   * commands:  import-conversations, remote-control (alias rc), sandbox
#                (+ its install/status subcommands)
#   * root:      --advisor --agent-color --agent-id --agent-name --agent-type
#                --append-subagent-system-prompt --append-system-prompt-file
#                --channels --correlation-id
#                --dangerously-load-development-channels --debug-to-stderr
#                --deep-link-cwd-b64 --deep-link-last-fetch --deep-link-origin
#                --deep-link-repo --enable-auth-status --enable-auto-mode
#                --forward-home-settings --init --init-only --maintenance
#                --managed-settings --max-thinking-tokens --max-turns
#                --messaging-socket-path --on-branch --parent-session-id
#                --permission-prompt-tool --plan-mode-instructions
#                --plan-mode-required --plugin-dir-no-mcp --pool --prefill
#                --prefill-b64 --rc --ref --remote --reply-on-resume
#                --resume-drops-turn --resume-session-at --rewind-files
#                --sdk-url --session-mirror --system-prompt-file --task-budget
#                --team-name --teammate-mode --thinking --thinking-display
#                --watch-artifact --watch-artifact-no-autoreact --workload
#   * agents:    --plugin-dir-no-mcp
#   * mcp add:   --xaa  (hideHelp(!enabled), so it is visible where XAA is on)
#   * plugin eval init: --interview
#   * --cowork on plugin details/disable/enable/install/list/prune/uninstall/
#     update/validate and plugin marketplace add/list/remove/update — and only
#     those: `plugin init`, `plugin tag` and `plugin eval` reject it.
#
# Scope is not uniform: root `--remote` is hidden while `plugin tag --remote`
# is documented, and a flat flag-to-hidden map will report that as a mismatch.
#
# `--tmux` registers as a boolean but argv preprocessing also accepts
# `--tmux=classic`, so it is spelled with an optional inline value here.
#
# Deliberately not completed: Commander's own `--help`/`--version` plumbing is
# offered, but nothing else machine-facing exists in this CLI to leave out.
#
# -----------------------------------------------------------------------------

_claude__message() {
  _message "${1:-value}"
}

_claude__prompt_text() {
  _claude__message 'prompt text'
}

_claude__shift_words() {
  local shift_count=$1
  local -a shifted
  local index

  shifted=()
  for (( index = shift_count + 1; index <= ${#words}; index++ )); do
    shifted+=("${words[index]}")
  done

  reply=("${shifted[@]}")
  REPLY=$(( CURRENT - shift_count ))
  (( REPLY < 1 )) && REPLY=1
}

