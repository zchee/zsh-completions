# _arguments only offers options once a '-' is typed, but 'mcp add' accepts them
# interleaved with its positionals, so list them alongside the positional too.
_claude__mcp_add_options() {
  local spec name desc
  local -a opts

  # Once a '-' is typed _arguments lists the options itself; adding them here
  # too would duplicate every entry.
  [[ $PREFIX == -* ]] && return

  _claude__mcp_add_specs
  for spec in "${reply[@]}"; do
    spec=${spec#\*}
    spec=${spec#\(*\)}
    [[ $spec == -* ]] || continue
    desc=${${spec#*\[}%%\]*}
    name=${spec%%[\[=]*}
    name=${name%[-+=]}
    opts+=("${name}:${desc}")
  done
  _describe 'option' opts
}

# Where a position has no real candidates of its own, the listed options are
# the only matches and all share a leading '-', which zsh would insert for you.
# Suppress that; positions that do have real matches must stay menu-cyclable.
_claude__suppress_insert() {
  [[ -z $PREFIX ]] && compstate[insert]=
}

_claude__mcp_add_name() {
  _claude__mcp_add_options
  _claude__message 'server name'
  _claude__suppress_insert
}

_claude__mcp_add_transport() {
  local transport="${opt_args[-t]:-${opt_args[--transport]}}"
  print -r -- "${transport%%:*}"
}

# Positional 2 of `mcp add` is a URL for http/sse and a command for stdio.
_claude__mcp_add_target() {
  case "$(_claude__mcp_add_transport)" in
    http|sse)
      _claude__mcp_add_options
      _claude__message 'server URL'
      _claude__suppress_insert
      ;;
    stdio)
      _claude__mcp_add_options
      _command_names -e
      ;;
    *)
      _claude__mcp_add_options
      _alternative \
        'commands:command:_command_names -e' \
        'urls:server URL: _claude__message "server URL"'
      ;;
  esac
}

# Trailing args belong to the spawned stdio command; remote transports take none.
_claude__mcp_add_rest() {
  case "$(_claude__mcp_add_transport)" in
    http|sse) _claude__message 'no further arguments' ;;
    *)
      # words here are the positionals (server name, command, args...) and
      # _normal reads words[1] as the command, so drop the server name first.
      (( CURRENT > 2 )) || { _claude__message 'command argument'; return }
      _claude__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _normal
      ;;
  esac
}

# Background sessions, for `attach`/`logs`/`stop`/`rm`/`respawn`. `claude
# agents` needs a TTY, so ask for the JSON listing instead; --all keeps the
# already-exited sessions that `rm` and `attach` still accept. Local, ~0.2 s.
# Interactive sessions carry a `pid` and no `id`, so they drop out naturally.
_claude__bg_sessions() {
  local -a sessions
  sessions=( ${(f)"$(_call_program bg-sessions claude agents --json --all 2>/dev/null </dev/null |
    awk '
      /"id"[[:space:]]*:/    { v = $0; sub(/.*"id"[[:space:]]*:[[:space:]]*"/, "", v); sub(/".*/, "", v); id = v }
      /"name"[[:space:]]*:/  { v = $0; sub(/.*"name"[[:space:]]*:[[:space:]]*"/, "", v); sub(/".*/, "", v); nm = v }
      /"state"[[:space:]]*:/ { v = $0; sub(/.*"state"[[:space:]]*:[[:space:]]*"/, "", v); sub(/".*/, "", v); st = v }
      /^[[:space:]]*\}/     { if (id != "") printf "%s:%s (%s)\n", id, nm, st; id = ""; nm = ""; st = "" }
    ')"} )

  if (( ${#sessions} )); then
    _describe -t sessions 'background session' sessions
  else
    _claude__message 'background session id'
  fi
}

