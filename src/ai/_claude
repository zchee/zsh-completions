_claude__complete_import() {
  _arguments -s \
    '--dry-run[show what would be imported without writing anything]' \
    '--yes=-[skip the interactive picker]::digest: _claude__message "digest"' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '::source:_claude__import_sources'
}

_claude__sandbox_commands() {
  local -a commands
  commands=(
    'install:install the Windows sandbox user and network filters'
    'status:print Windows sandbox availability and install state as JSON'
    'help:display help for command'
  )
  _describe 'sandbox command' commands
}

_claude__complete_sandbox() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -s \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:sandbox command:->command' \
    '*::sandbox argument:->args'

  case $state in
    command)
      _claude__sandbox_commands
      return
      ;;
  esac

  case $words[1] in
    install|status)
      _claude__complete_help_only_leaf
      ;;
    help)
      _arguments -s \
        '1:sandbox command:_claude__sandbox_commands' \
        '(-h --help)'{-h,--help}'[display help for command]'
      ;;
  esac
}

_claude__complete_import_conversations() {
  _arguments -s \
    '--cwd=[archive directory the imported sessions anchor to]:dir:_files -/' \
    '--dry-run[parse and verify manifest without writing files]' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:export path:_files'
}

_claude__complete_ultrareview() {
  _arguments -s \
    '--json[print the raw bugs.json payload instead of formatted findings]' \
    '(--post --no-post)--post[post the findings to the PR as you (PR targets only)]' \
    '(--post --no-post)--no-post[do not post the findings to the PR (default)]' \
    '--timeout=[maximum minutes to wait for the review to finish]:minutes: _claude__message "minutes"' \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '::target: _claude__message "target"'
}

_claude__project_commands() {
  local -a commands
  commands=(
    'help:display help for command'
    'purge:delete all Claude Code state for a project'
  )
  _describe 'project command' commands
}

_claude__complete_project() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C -s \
    '(-h --help)'{-h,--help}'[display help for command]' \
    '1:project command:->command' \
    '*::project argument:->args'

  case $state in
    command)
      _claude__project_commands
      return
      ;;
  esac

  case $words[1] in
    purge)
      _arguments -s \
        '--all[purge state for every project]' \
        '--dry-run[list what would be deleted without deleting anything]' \
        '(-i --interactive)'{-i,--interactive}'[prompt for each item before deleting]' \
        '(-y --yes)'{-y,--yes}'[skip confirmation prompt]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1:path:_files -/'
      ;;
    help)
      _arguments -s \
        '1:project command:_claude__project_commands' \
        '(-h --help)'{-h,--help}'[display help for command]'
      ;;
  esac
}

_claude__complete_top_help_leaf() {
  _arguments -s \
    '(-h --help)'{-h,--help}'[display help for command]'
}

function _claude() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a specs

  _claude__top_option_specs
  specs=("${reply[@]}")

  _arguments -C -s \
    ${specs[@]} \
    '1:claude command:->command' \
    '*::claude argument:->args'

  case $state in
    command)
      _claude__top_commands
      return
      ;;
    args)
      case $words[1] in
        agents)
          _claude__complete_agents
          ;;
        attach|logs|rm|stop|kill)
          _claude__complete_bg_session
          ;;
        auth)
          _claude__complete_auth
          ;;
        auto-mode)
          _claude__complete_auto_mode
          ;;
        doctor|setup-token|update|upgrade)
          _claude__complete_top_help_leaf
          ;;
        gateway)
          _claude__complete_gateway
          ;;
        import)
          _claude__complete_import
          ;;
        import-conversations)
          _claude__complete_import_conversations
          ;;
        install)
          _claude__complete_install
          ;;
        mcp)
          _claude__complete_mcp
          ;;
        plugin|plugins)
          _claude__complete_plugin
          ;;
        project)
          _claude__complete_project
          ;;
        respawn)
          _claude__complete_respawn
          ;;
        rc|remote-control)
          _claude__complete_remote_control
          ;;
        sandbox)
          _claude__complete_sandbox
          ;;
        ultrareview)
          _claude__complete_ultrareview
          ;;
        *)
          _arguments -s '*::prompt:_claude__prompt_text'
          ;;
      esac
      ;;
  esac
}

_claude "$@"

