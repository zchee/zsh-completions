    '--provider=[search provider]:provider: _gjc__search_providers' \
    '--recency=[recency filter]:recency:(day week month year)' \
    {-l,--limit=}'[max results to return]:count: _gjc__message "count"' \
    '--xai-mode=[xAI mode]:mode:(web x web_and_x)' \
    '--allowed-domain=[xAI web_search allowed domains, comma-separated]:domains: _gjc__message "domains"' \
    '--allowed-domains=[xAI web_search allowed domains, comma-separated]:domains: _gjc__message "domains"' \
    '--excluded-domain=[xAI web_search excluded domains, comma-separated]:domains: _gjc__message "domains"' \
    '--excluded-domains=[xAI web_search excluded domains, comma-separated]:domains: _gjc__message "domains"' \
    '--allowed-x-handle=[xAI x_search allowed handles, comma-separated]:handles: _gjc__message "handles"' \
    '--allowed-x-handles=[xAI x_search allowed handles, comma-separated]:handles: _gjc__message "handles"' \
    '--excluded-x-handle=[xAI x_search excluded handles, comma-separated]:handles: _gjc__message "handles"' \
    '--excluded-x-handles=[xAI x_search excluded handles, comma-separated]:handles: _gjc__message "handles"' \
    '--from-date=[xAI x_search start date (ISO8601)]:date: _gjc__message "date"' \
    '--to-date=[xAI x_search end date (ISO8601)]:date: _gjc__message "date"' \
    '--image-understanding[enable xAI image understanding]' \
    '--image-search[enable xAI web image search]' \
    '--video-understanding[enable xAI X video understanding]' \
    '--no-inline-citations[disable xAI inline citation markdown]' \
    '--compact[render condensed output]' \
    '*:query: _gjc__message "query"'
}

_gjc__local_provider() {
  _arguments -s -S : \
    '(- *)'{-h,--help}'[show help]' \
    '--model=[model id to use for smoke]:model:_gjc__models' \
    '--models-path=[override models config path]:file:_files' \
    '--timeout-ms=[request timeout in milliseconds]:ms: _gjc__message "ms"' \
    '--smoke[run optional streaming chat smoke during status/diagnose]' \
    '--json[output JSON]' \
    '1:action:((status\:"summarize configured local providers" diagnose\:"diagnose provider reachability" discover\:"discover local endpoints" models\:"list provider models" smoke\:"run a streaming chat smoke test"))'
}

_gjc__read() {
  _arguments -s -S : \
    '(- *)'{-h,--help}'[show help]' \
    '--truncation=[which end of an over-budget result to keep]:mode:((head\:"keep the beginning" last\:"keep the end" both\:"keep both ends"))' \
    '1:path or URL:_files'
}

_gjc__completion() {
  _arguments -s -S : \
    '(- *)'{-h,--help}'[show help]' \
    '--install[install the generated spec for inshellisense]' \
    '--dir=[install directory]:directory:_files -/' \
    '--force[overwrite an existing non-GJC inshellisense index.js]' \
    '--json[output JSON instead of JavaScript or status text]' \
    '1:target:((inshellisense\:"inshellisense spec" fig\:"alias for inshellisense"))'
}

_gjc__sdk() {
  _arguments -s -S : \
    '(- *)'{-h,--help}'[show help]' \
    '--stdio[serve SDK frames over standard input and output]' \
    '--socket=[serve SDK frames over a Unix socket path]:socket:_files' \
    '--session=[attach to a specific SDK session]:id: _gjc__message "id"' \
    '--pending-ceiling=[maximum queued relay bytes per direction]:bytes: _gjc__message "bytes"' \
    '1:action:((serve\:"serve the SDK protocol"))'
}

_gjc__internal() {
  _arguments -s -S : \
    '1:probe:((memory-guard-native-smoke\:"(hidden) native Windows job memory probe"))' \
    '--json[emit machine-readable JSON]'
}

_gjc() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  local -a root_args
  root_args=(
    '(- *)'{-h,--help}'[show help]'
    '(- *)'{-v,--version}'[show version]'
    '--model=[model to use (fuzzy match)]:model:_gjc__models'
    '--smol=[smol/fast model for lightweight tasks]:model:_gjc__models'
    '--slow=[slow/reasoning model for thorough analysis]:model:_gjc__models'
    '--plan=[plan model for architectural planning]:model:_gjc__models'
    '--mpreset=[model profile preset to activate for this session]:preset:_gjc__mpresets'
    '--default[persist --mpreset as the default model profile]'
    '--provider=[provider to use (legacy; prefer --model)]:provider: _gjc__provider'
    '--api-key=[API key (defaults to env vars)]:key: _gjc__message "key"'
    '--credential=[stored credential selector]:selector:_gjc__credential'
    '--system-prompt=[system prompt]:prompt: _gjc__message "prompt"'
    '--append-system-prompt=[append text or file contents to the system prompt]:text or file:_files'
    '--mcp-config=[tools-only MCP config file (absolute path)]:file:_files'
    '--allow-home[allow starting in ~ without auto-switching to a temp dir]'
    '--mode=[output mode]:mode:_gjc__mode'
    {-p,--print}'[non-interactive mode: process prompt and exit]'
    {-c,--continue}'[continue previous session]'
    {-r,--resume=}'-[resume a session (by ID prefix, path, or picker if omitted)]::session: _gjc__message "session"'
    '--session-dir=[explicit session storage and lookup directory]:directory:_files -/'
    '--no-session[do not save session (ephemeral)]'
    '--models=[comma-separated model patterns for Alt+N cycling]:patterns:_gjc__model_list'
    '--no-tools[disable all built-in tools]'
    '--no-lsp[disable LSP tools, formatting, and diagnostics]'
    '--no-pty[disable PTY-based interactive bash execution]'
    '--tmux[launch interactive startup inside tmux]'
    '--tools=[comma-separated list of tools to enable]:tools:_gjc__tools'
    '--thinking=[set thinking level]:level:(minimal low medium high xhigh max)'
    '--no-rules[disable rules discovery and loading]'
    '--export=[export session file to HTML and exit]:session file:_files'
    '--list-models=-[list available models (with optional fuzzy search)]::pattern: _gjc__message "pattern"'
    '--no-title[disable title auto-generation]'
    {-w,--worktree=}'-[run in a sibling git worktree (detached when no name given)]::branch name: _gjc__message "branch name"'
    # Advertised in `--help` but no longer read by the root parser.
    '*--hook=[(no-op) load a hook/extension file]:file:_files'
    '*'{-e,--extension=}'[(no-op) load an extension file]:file:_files'
    '--no-extensions[(no-op) disable extension discovery]'
    '--no-skills[(no-op) disable skills discovery and loading]'
    '--skills=[(no-op) comma-separated glob patterns to filter skills]:patterns: _gjc__message "patterns"'
    # Parsed by the root parser but absent from `--help`.
    '--session=[(hidden) alias for --resume]:session: _gjc__message "session"'
    '--fork=[(hidden) fork an existing session by id]:session: _gjc__message "session"'
    '--provider-session-id=[(hidden) reuse an upstream provider session id]:id: _gjc__message "id"'
    '--acp-terminal-auth[(hidden) run terminal auth bootstrap for ACP clients]'
    # Root fast paths handled before command dispatch.
    '(- *)--smoke-test[(hidden) run the bundled worker/native smoke test]'
    '(- *)--fixture=[(hidden) render a fixture report and exit]:fixture id: _gjc__message "fixture id"'
    '--team[(hidden, legacy) route to `gjc team`; requires --team-size]'
    '--team-size=[(hidden, legacy) worker count for --team]:count: _gjc__message "count"'
    '1:command:->command'
    '*::arg:->args'
  )

  # -A stops root option matching once a command word is seen, so a subcommand
  # flag is never shadowed by the same-named root flag (e.g. web-search --provider).
  _arguments -C -s -S : $root_args && ret=0

  case $state in
    command)
      local -a commands
      commands=(
        'launch:start an explicit launch/session workflow'
        'setup:install GJC defaults or optional dependencies'
        'session:list, inspect, create, remove, or attach sessions'
        'state:inspect or manage persisted GJC state'
        'harness:run harness control-plane commands'
        'coordinator:manage coordinator/runtime coordination helpers'
        'team:run tmux-backed coordinated execution'
        'ultragoal:run durable goal execution workflow'
        'ralplan:run consensus planning workflow'
        'deep-interview:run requirements interview workflow'
        'skills:list/read embedded workflow skills'
        'config:list, get, and set configuration values'
        'stats:view AI usage statistics (tokens, cost, requests)'
        'notify:send or test notifications'
        'daemon:manage background daemon helpers'
        'mcp:manage MCP server registrations'
        'mcp-serve:serve the MCP integration endpoint'
        'contribute-pr:prepare contribution/PR workflow artifacts'
        'migrate:run migration helpers'
        'rlm:run RLM helpers'
        'update:update GJC installation artifacts'
        'plugin:install, remove, and list plugins'
        'web-search:search the web from the CLI'
        'q:search the web from the CLI (alias for web-search)'
        'codex-native-hook:run Codex native hook integration'
        'gc:run garbage-collection/cleanup helpers'
        'acp:(hidden) run Gajae Code as an ACP server over stdio'
        'sdk:(hidden) serve the Gajae Code SDK protocol'
        'local-provider:(hidden) diagnose configured local OpenAI-compatible providers'
        'read:(hidden) show what the read tool returns for a path or URL'
        'completion:(hidden) generate shell completion specs'
        'contribution-prep:(hidden) alias for contribute-pr'
        'resume:(hidden) shorthand for `gjc --resume`'
        'coordinator-mcp:(hidden, legacy) alias for `gjc mcp-serve coordinator`'
        'internal:(hidden) internal diagnostic probes'
      )
      if compset -P '@'; then
        _files && ret=0
      else
        _describe -t commands 'command' commands && ret=0
      fi
      ;;
    args)
      curcontext="${curcontext%:*:*}:gjc-$line[1]:"
      case $line[1] in
        launch)                     _gjc__launch_args && ret=0 ;;
        setup)                      _gjc__setup && ret=0 ;;
        session)                    _gjc__session && ret=0 ;;
        state)                      _gjc__state && ret=0 ;;
        harness)                    _gjc__harness && ret=0 ;;
        coordinator)                _gjc__coordinator && ret=0 ;;
        team)                       _gjc__team && ret=0 ;;
        ultragoal)                  _gjc__ultragoal && ret=0 ;;
        ralplan)                    _gjc__ralplan && ret=0 ;;
        deep-interview)             _gjc__deep_interview && ret=0 ;;
        skills)                     _gjc__skills && ret=0 ;;
        config)                     _gjc__config && ret=0 ;;
        stats)                      _gjc__stats && ret=0 ;;
        notify)                     _gjc__notify && ret=0 ;;
        daemon)                     _gjc__daemon && ret=0 ;;
        mcp)                        _gjc__mcp && ret=0 ;;
        mcp-serve|coordinator-mcp)  _gjc__mcp_serve && ret=0 ;;
        contribute-pr|contribution-prep) _gjc__contribute_pr && ret=0 ;;
        migrate)                    _gjc__migrate && ret=0 ;;
        rlm)                        _gjc__rlm && ret=0 ;;
        update)                     _gjc__update && ret=0 ;;
        plugin)                     _gjc__plugin && ret=0 ;;
        web-search|q)               _gjc__web_search && ret=0 ;;
        gc)                         _gjc__gc && ret=0 ;;
        local-provider)             _gjc__local_provider && ret=0 ;;
        read)                       _gjc__read && ret=0 ;;
        completion)                 _gjc__completion && ret=0 ;;
        sdk)                        _gjc__sdk && ret=0 ;;
        internal)                   _gjc__internal && ret=0 ;;
        acp|codex-native-hook)
          _arguments -s -S : '(- *)'{-h,--help}'[show help]' && ret=0 ;;
        resume)
          _gjc__message 'session id, path, or empty for the picker' && ret=0 ;;
        *)
          _gjc__launch_args && ret=0 ;;
      esac
      ;;
  esac

  return ret
}

_gjc "$@"

