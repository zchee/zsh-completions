_gjc__message() {
  _message "${1:-value}"
}

_gjc__json_input() {
  if compset -P '@'; then
    _files
    return
  fi
  _message 'inline JSON object, or @file'
}

# Canonical model ids plus fully-qualified provider/model ids.
_gjc__models() {
  local -a models
  models=( ${(f)"$(_call_program gjc-models gjc --list-models 2>/dev/null | awk '
    /^Canonical models$/ { section = "canonical"; next }
    /^Provider models$/  { section = "provider";  next }
    /^canonical[ \t]/    { next }
    /^provider[ \t]/     { next }
    NF == 0              { next }
    section == "canonical" { print $1; next }
    section == "provider"  { print $1 "/" $2; next }
  ')"} )

  if (( ${#models} )); then
    _describe -t models 'model' models
  else
    _gjc__message 'model'
  fi
}

# Comma-separated model patterns (--models / Alt+N cycling).
_gjc__model_list() {
  compset -P '*,'
  _gjc__models
}

# Stored credential selector: email:<addr>, id:<n>, account:<id>, project:<id>,
# or provider/email:<addr>.
_gjc__credential() {
  if compset -P '(|*/)(email|id|account|project):'; then
    _message 'selector value'
    return
  fi
  local -a selectors
  selectors=(
    'email\::match a stored credential by email address'
    'id\::match by numeric credential id'
    'account\::match by account id'
    'project\::match by project id'
  )
  _describe -t selectors 'credential selector' selectors -S ''
}

_gjc__git_branches() {
  local -a branches
  # _call_program evals its arguments, so the format string needs to survive one
  # extra round of quote stripping.
  branches=( ${(f)"$(_call_program gjc-branches git for-each-ref "--format='%(refname:short)'" refs/heads refs/remotes 2>/dev/null)"} )
  if (( ${#branches} )); then
    _describe -t branches 'branch' branches
  else
    _gjc__message 'branch'
  fi
}

