# The state fields the renderer accepts; comma-separated.
_gjc__state_fields() {
  _values -s , 'state field' \
    skill phase current_phase next active status fresh fresh_until receipt \
    artifact_path plan_path spec_path run_id stage stage_n session_id \
    updated_at handoff_to handoff_from counts hud
}

# `--lane-verdict` values depend on the lane selected by --stage.
_gjc__lane_verdict() {
  local i
  for (( i = 1; i <= ${#words}; i++ )); do
    [[ ${words[i]} == --stage ]] && case ${words[i+1]} in
      (architect) _values 'architect verdict' CLEAR WATCH BLOCK; return ;;
      (critic)    _values 'critic verdict' OKAY ITERATE REJECT; return ;;
    esac
    [[ ${words[i]} == --stage=architect ]] && { _values 'architect verdict' CLEAR WATCH BLOCK; return }
    [[ ${words[i]} == --stage=critic ]] && { _values 'critic verdict' OKAY ITERATE REJECT; return }
  done
  _values 'lane verdict' CLEAR WATCH BLOCK OKAY ITERATE REJECT
}

