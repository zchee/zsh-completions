# Root _arguments owns option matching for the whole line, so a flag that exists
# both at the root and on a subcommand would otherwise always resolve to the root
# value set. Resolve from the command word actually present instead.
_gjc__subcommand() {
  local word
  for word in ${words[2,-1]}; do
    case $word in
      (-*) continue ;;
      (*) print -r -- $word; return ;;
    esac
  done
}

_gjc__provider() {
  case $(_gjc__subcommand) in
    (web-search|q) _gjc__search_providers ;;
    (*) _gjc__message 'provider' ;;
  esac
}

_gjc__mode() {
  case $(_gjc__subcommand) in
    (ultragoal)
      _describe -t modes 'review mode' '(
        review-only:review\ without\ starting\ work
        review-start:review\ then\ start\ the\ review\ workflow
      )' ;;
    (*)
      _describe -t modes 'output mode' '(
        text:human-readable\ text\ \(default\)
        json:machine-readable\ JSON
        acp:Agent\ Client\ Protocol
      )' ;;
  esac
}

