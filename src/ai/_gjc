    '--provider-session-id=[(hidden) reuse an upstream provider session id]:id: _gjc__message "id"'
    '--acp-terminal-auth[(hidden) run terminal auth bootstrap for ACP clients]'
    '*:message or @file:_gjc__prompt_or_file'
  )

  _arguments -s -S : $args
}

