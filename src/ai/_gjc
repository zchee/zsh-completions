_gjc__session() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C -s -S : \
    '(- *)'{-h,--help}'[show help]' \
    {-j,--json}'[emit machine-readable JSON]' \
    '--session-id=[expected @gjc-session-id tag for force-close]:id: _gjc__message "id"' \
    '--state-file=[expected @gjc-session-state-file tag for force-close]:file:_files' \
    '1:action:->action' \
    '2:session:->session' && ret=0

  case $state in
    action)
      local -a actions=(
        'list:list tagged GJC-managed tmux sessions (default)'
        'status:show status for a session'
        'create:create a new tagged session'
        'attach:attach to a session'
        'remove:remove a session'
        'force-close:(hidden) force-close a session with tag verification'
      )
      _describe -t actions 'action' actions && ret=0
      ;;
    session)
      _gjc__sessions && ret=0
      ;;
  esac

  return ret
}

_gjc__state() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C -s -S : \
    '(- *)'{-h,--help}'[show help]' \
    '--input=[JSON payload (or @file) for the action]:json:_gjc__json_input' \
    '--session-id=[session-scoped .gjc/_session-{id} directory]:id: _gjc__message "id"' \
    '--thread-id=[thread id selector]:id: _gjc__message "id"' \
    '--turn-id=[turn id selector]:id: _gjc__message "id"' \
    '--skill=[workflow skill to target]:skill:(deep-interview ralplan ultragoal team)' \
    '--mode=[workflow mode to target]:mode:(deep-interview ralplan ultragoal team)' \
    '--to=[handoff target skill]:skill:(deep-interview ralplan ultragoal team)' \
    '--fields=[project a subset of state fields]:fields:_gjc__state_fields' \
    '--limit=[maximum records to return]:count: _gjc__message "count"' \
    '--since=[only records at or after this ISO timestamp or age]:since:(30m 6h 7d)' \
    '--older-than=[prune records older than this age in days]:days: _gjc__message "days"' \
    '--status=[filter by record status]:status: _gjc__message "status"' \
    '--format=[graph output format]:format:(ascii mermaid dot)' \
    '--history[include the state history journal]' \
    '--compact[emit compact output]' \
    '--replace[replace state instead of merging]' \
    '--force[bypass guard checks]' \
    '--hard[perform a hard prune]' \
    '--dry-run[preview without writing]' \
    '--json[emit machine-readable JSON]' \
    '1:action or skill:->first' \
    '2:action:->second' && ret=0

  case $state in
    first)
      local -a actions skills
      actions=(
        'read:print the persisted state envelope'
        'write:merge a JSON payload into state'
        'clear:clear state for the session'
        'contract:print the workflow state contract'
        'handoff:hand off to the next workflow skill'
        'graph:render the workflow state graph'
        'prune:prune stale state records'
        'gc:garbage-collect state records'
        'migrate:migrate legacy state layouts'
