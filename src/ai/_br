typeset -ga _br_global_options
_br_global_options=(
  '--db[Database path (auto-discover .beads/*.db if not set)]:db:_files'
  '--actor[Actor name for audit trail]:actor: _br__message "actor"'
  '--json[Output as JSON]'
  '--no-daemon[Force direct mode (no daemon) - effectively no-op in br v1]'
  '--no-auto-flush[Skip auto JSONL export]'
  '--no-auto-import[Skip auto import check]'
  '--allow-stale[Allow stale DB (bypass freshness check warning)]'
  '--lock-timeout[SQLite busy/write-lock timeout in ms]:lock-timeout: _br__message "lock-timeout (number)"'
  '--no-db[JSONL-only mode (no DB connection)]'
  '*'{-v,--verbose}'[Increase logging verbosity (-v, -vv)]'
  '(-q --quiet)'{-q,--quiet}'[Quiet mode (no output except errors)]'
  '--no-color[Disable colored output]'
)

# -----------------------------------------------------------------------------
# Value helpers.
#
# Dynamic sets are delegated to br's own dynamic-completion engine, which reads
# .beads/*.jsonl directly (~10ms) instead of going through the SQLite database
# (`br label list-all` takes ~2s and is unusable during completion).
# -----------------------------------------------------------------------------

# Ask br's dynamic completer what belongs at the cursor position of the
# *original* command line, saved by _br() before _arguments rewrote $words.
# Returns raw "value:description" lines.
_br__clap_candidates() {
  [[ -n $_br_clap_cmd ]] || return 1
  COMPLETE=zsh \
  _CLAP_IFS=$'\n' \
  _CLAP_COMPLETE_INDEX=$_br_clap_index \
    "$_br_clap_cmd" -- "${_br_clap_words[@]}" 2>/dev/null
}

# Feed the engine's output to _describe. $1 = tag, $2 = description.
#
# At a slot where options are also legal (a bare positional, say) the engine
# returns flags alongside the values. _arguments already offers those, and they
# are not values of this tag, so drop anything that looks like an option.
_br__clap_describe() {
  local tag=$1 desc=$2
  local -a cands
  cands=( ${${(f)"$(_br__clap_candidates)"}:#-*} )
  (( ${#cands} )) || return 1
  _describe -t "$tag" "$desc" cands
}

_br__issue_ids()        { _br__clap_describe issue-ids   'issue' }
_br__open_issue_ids()   { _br__clap_describe issue-ids   'open issue' }
_br__closed_issue_ids() { _br__clap_describe issue-ids   'closed issue' }
_br__labels()           { _br__clap_describe labels      'label' }
_br__assignees()        { _br__clap_describe assignees   'assignee' }
_br__owners()           { _br__clap_describe owners      'owner' }
_br__config_keys()      { _br__clap_describe config-keys 'config key' }
_br__saved_queries()    { _br__clap_describe queries     'saved query' }

# Comma-separated label list; complete one element at a time.
_br__labels_delim() {
  compset -P '*,'
  _br__clap_describe labels 'label'
}

