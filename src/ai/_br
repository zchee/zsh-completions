_br__agents() {
  local ret=1

  _arguments -s -S \
    "${_br_global_options[@]}" \
    '(- : *)'{-h,--help}'[Print help]' \
    '--add[Add beads workflow instructions to AGENTS.md]' \
    '--remove[Remove beads workflow instructions from AGENTS.md]' \
    '--update[Update beads workflow instructions to latest version]' \
    '--check[Check status only (default behavior)]' \
    '--dry-run[Preview changes without modifying files]' \
    '(-f --force)'{-f,--force}'[Skip confirmation prompts]' && ret=0

  return ret
}

_br__audit() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C -s -S \
    "${_br_global_options[@]}" \
    '(- : *)'{-h,--help}'[Print help]' \
    '1:subcommand:->subcommand' \
    '*::arg:->args' && ret=0

  case $state in
    subcommand)
      local -a subcommands
      subcommands=(
        'record:Append an audit interaction entry'
        'coordination:Record coordination status rows as bounded audit interactions'
        'label:Append a label entry referencing an existing interaction'
        'log:View audit log for an issue'
        'summary:View audit summary'
      )
      _describe -t subcommands 'br audit subcommand' subcommands && ret=0
      ;;
    args)
      curcontext="${curcontext%:*:*}:br-audit-$line[1]:"
      case $line[1] in
        record) _br__audit_record && ret=0 ;;
        coordination) _br__audit_coordination && ret=0 ;;
        label) _br__audit_label && ret=0 ;;
        log) _br__audit_log && ret=0 ;;
        summary) _br__audit_summary && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

