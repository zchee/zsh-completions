    "${_br_global_options[@]}" \
    '(- : *)'{-h,--help}'[Print help]' \
    '1:subcommand:->subcommand' \
    '*::arg:->args' && ret=0

  case $state in
    subcommand)
      local -a subcommands
      subcommands=(
        'plan:Inspect the live database and emit a token bound to its exact file-family state'
        'apply:Apply the reviewed migration only when the live state still matches a plan token'
        'undo:Restore the exact pre-migration database family from a completed run'
      )
      _describe -t subcommands 'br doctor migrate-schema subcommand' subcommands && ret=0
      ;;
    args)
      curcontext="${curcontext%:*:*}:br-doctor-migrate-schema-$line[1]:"
      case $line[1] in
        plan) _br__doctor_migrate_schema_plan && ret=0 ;;
        apply) _br__doctor_migrate_schema_apply && ret=0 ;;
        undo) _br__doctor_migrate_schema_undo && ret=0 ;;
      esac
      ;;
  esac
  return ret
}

