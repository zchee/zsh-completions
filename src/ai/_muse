            '--in-reply-to[reply token of the message being answered]:reply token:' \
            '--display-context[display context JSON]:display context JSON:' \
            '--json[emit JSON]' \
            && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

(( $+functions[_muse__mcp] )) ||
_muse__mcp() {
  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args

  _arguments -C \
    '1: :->command' \
    '*::arg:->args' \
    && ret=0

  case $state in
    command)
      local -a commands
      commands=(
        'login:authorize an MCP server with OAuth (browser or headless)'
        'logout:remove stored OAuth credentials for an MCP server'
      )
      _describe -t commands 'muse mcp command' commands && ret=0
      ;;
    args)
      case $words[1] in
        login)
          _arguments \
            '(- *)--help[print help]' \
            '--oauth-client-id[use this public client ID]:client ID:' \
            '*--scope[request this scope (repeatable or comma-separated)]:scope:' \
            '--headless[print the URL, do not open a browser, and paste the final redirect URL]' \
            '--callback-port[loopback callback port]:port:' \
            '1: :_muse__mcp_servers' \
            && ret=0
          ;;
        logout)
          _arguments \
            '(- *)--help[print help]' \
            '1: :_muse__mcp_servers' \
            && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

