# Muse Code (Meta) — no public upstream source; built from Meta's internal
# fbcode/musecode tree and installed by https://api.meta.ai/muse-launcher.sh
#
# Muse Code 1.4.0 (1.4.0-R4161.1)
#
# `muse` is a bash launcher that self-updates and then execs
# muse-bin-<version> with the arguments untouched. The binary is Rust: the root
# and `resume`, `auth set` and `trace inspect` parse with clap; every other
# subcommand has a hand-rolled parser with its own help dialect. The
# hand-rolled parsers reject `--flag=value`, so every value is completed as a
# separate word.
#
# Derived from the `--help` of every command path, plus a sweep of every
# `--long-flag` literal in the binary's string table through a per-scope
# oracle (`muse <path> --CAND --zz-s1 --zz-s2`, with a `--zz-control` sentinel
# as the control) and the packed top-level dispatch table.
#
# Hidden surface, all confirmed against the binary:
#   * command:        workflows (list, save, and the QA-only run/recover)
#   * root flag:      --last (the root copy of `resume --last`)
#   * exec flags:     --agents, --eval-context-compaction-strategy,
#                     --eval-workflow-api-version
#   * skills list:    --scope
#   * skills inspect: --scope, --enabled-only
#   * skills enable, user-only, disable:
#                     --source, --enabled-only
#
# Deliberately left out:
#   * `plugins` is dispatched but only prints "plugins are not available in
#     this build".
#   * `serve --yolo/--approval-mode/--approval-judge/--disable-approval/
#     --listen` are recognized only to be refused with an explanation.
#   * `skills validate/update/uninstall/install` parse the whole skills option
#     set, then reject the extras with "option --X is not supported for this
#     command".
#
# -----------------------------------------------------------------------------

(( $+functions[_muse__sessions] )) ||
_muse__sessions() {
  local db=${XDG_DATA_HOME:-$HOME/.local/share}/muse/session-index.db
  local sql="select session_id, coalesce(session_name, ''), title from sessions order by updated_at_us desc limit 200"
  local -a rows ids names dirs
  local row id name title
  if [[ -r $db ]] && (( $+commands[sqlite3] )); then
    rows=(${(f)"$(_call_program sessions sqlite3 -readonly -separator ${(q):-$'\t'} ${(q)db} ${(q)sql} 2>/dev/null)"})
    for row in $rows; do
      id=${row%%$'\t'*}
      row=${row#*$'\t'}
      name=${row%%$'\t'*}
      title=${row#*$'\t'}
      [[ -n $id ]] || continue
      ids+=("${id//:/\\:}:${title:-session}")
      [[ -n $name ]] && names+=("${name//:/\\:}:${title:-session} ($id)")
    done
  fi
  # The index is filled lazily, so it can lag the session directories.
  if (( ! $#ids )); then
    dirs=(${XDG_DATA_HOME:-$HOME/.local/share}/muse/sessions/*/*/*/*(N/om:t))
    ids=(${dirs//:/\\:})
  fi
  _describe -t session-ids 'session id' ids -- names
}

(( $+functions[_muse__session_or_log] )) ||
_muse__session_or_log() {
  _alternative \
    'sessions: :_muse__sessions' \
    'files:session log:_files -g "*.jsonl(-.)"'
}

(( $+functions[_muse__skills] )) ||
_muse__skills() {
  local -a rows skills
  local row name scope desc
  rows=(${(f)"$(_call_program skills MUSE_NO_AUTO_UPDATE=1 ${(q)_muse_bin} skills list 2>/dev/null)"})
  for row in $rows; do
    name=${row%%$'\t'*}
    row=${row#*$'\t'}
    scope=${row%%$'\t'*}
    row=${row#*$'\t'}
    [[ $scope == (user|project|built-in|plugin) ]] || continue
    desc=${${row#*$'\t'}%%$'\t'*}
    skills+=("${name//:/\\:}:[$scope] ${desc[1,100]}")
  done
  _describe -t skills 'skill' skills
}

(( $+functions[_muse__skill_or_path] )) ||
_muse__skill_or_path() {
  _alternative \
    'skills: :_muse__skills' \
    'files:skill path:_files'
}

(( $+functions[_muse__mcp_servers] )) ||
_muse__mcp_servers() {
  local -a files servers
  local f
  for f in ${XDG_CONFIG_HOME:-$HOME/.config}/muse/settings.json .claude/settings.json .claude/settings.local.json; do
    [[ -r $f ]] && files+=($f)
  done
  if (( $#files )) && (( $+commands[jq] )); then
    servers=(${(fu)"$(_call_program mcp-servers jq -r ${(q):-'.mcpServers // {} | to_entries[] | select(.value.url != null) | .key'} ${(q)files} 2>/dev/null)"})
  fi
  if (( $#servers )); then
    _describe -t mcp-servers 'MCP server' servers
  else
    _message 'MCP server (a streamable-HTTP entry under mcpServers in settings.json)'
  fi
}

(( $+functions[_muse__git_refs] )) ||
_muse__git_refs() {
  local -a refs
  refs=(${(f)"$(_call_program refs git for-each-ref "--format='%(refname:short)'" refs/heads refs/remotes refs/tags 2>/dev/null)"})
  _describe -t refs 'git ref' refs
}

