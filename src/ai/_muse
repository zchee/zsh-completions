(( $+functions[_muse__workflows] )) ||
_muse__workflows() {
  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args

  _arguments -C \
    '1: :->command' \
    '*::arg:->args' \
    && ret=0

  case $state in
    command)
      local -a commands
      commands=(
        'list:list saved named workflows'
        'save:save a workflow script under a name'
        'run:run a workflow entry headlessly (QA-only)'
        'recover:recover a workflow run from its session log (QA-only)'
      )
      _describe -t commands 'muse workflows command' commands && ret=0
      ;;
    args)
      case $words[1] in
        list)
          _message 'no arguments'
          ;;
        save)
          _arguments \
            '--from[workflow script to save]:workflow script:_files -g "*.js(-.)"' \
            '--scope[where to save the workflow]:scope:(project user)' \
            '--overwrite[replace an existing workflow of the same name]' \
            '1:workflow name:' \
            && ret=0
          ;;
        run)
          _arguments \
            '--headless-qa[run in the headless QA lane (required)]' \
            '--token-budget[token budget]:tokens (N, Nk, or Nm):' \
            '(--prompt-live-smoke)--live-auto-qa[live auto-QA run (needs TBH_WORKFLOW_PRODUCT_LIVE_AUTO_QA=1)]' \
            '(--live-auto-qa)--prompt-live-smoke[prompt live smoke run (needs TBH_WORKFLOW_PROMPT_LIVE_SMOKE=1)]' \
            '1:workflow entry:_files -g "*.js(-.)"' \
            && ret=0
          ;;
        recover)
          _arguments \
            '--apply[apply the recovery instead of planning it]' \
            '(--session)--session-log[session log of the workflow run]:session log:_files -g "*.jsonl(-.)"' \
            '(--session-log)--session[session id of the workflow run]: :_muse__sessions' \
            '1:workflow run id:' \
            && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

