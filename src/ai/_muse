function _muse() {
  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args
  local _muse_bin=${words[1]}

  # Options shared by the TUI root, `resume` and `exec`.
  local -a run_opts
  run_opts=(
    '--provider[startup provider]: :_muse__providers'
    '--preset[run a built-in preset]:preset:(native-basic miniswe)'
    '--model[model id for non-echo providers]:model id:'
    '--reasoning-effort[Meta reasoning effort]:effort:(none minimal low medium high xhigh max ultra)'
    '--base-url[override the Meta provider base URL]:URL:_urls'
    '*--image[attach a local image file to the next submitted prompt]:image file:_files'
    '--workspace[register policy-gated workspace tools rooted at PATH]:workspace:_directories'
    '--worktree-base[base ref for --worktree create]: :_muse__git_refs'
    '--worktree-existing[existing worktree path for --worktree existing]:worktree:_directories'
    '(--no-parallel-tool-calls)--parallel-tool-calls[enable Meta API parallel tool calls]'
    '(--parallel-tool-calls)--no-parallel-tool-calls[disable Meta API parallel tool calls]'
    '--subagent-worktree-isolation[compatibility flag; subagent worktree isolation defaults on]'
    '--approval-mode[tool approval mode]: :_muse__approval_modes'
    '--permission-profile[select a named permission profile for this session]:permission profile id:'
    '--approval-judge[LLM approval judge for Prompt-bound calls]:judge:(off on)'
    '--no-session-log[do not persist session event logs to disk]'
    '--yolo[disable approval and sandboxing and trust this workspace for this run]'
    '--trust-workspace[trust this workspace for this run (load its skills and rules)]'
    '--disable-approval[disable tool approval prompts for this run]'
    '--disable-sandbox[disable shell filesystem/network sandboxing for this run]'
    '--sandbox-network[sandbox network mode]: :_muse__sandbox_network'
    '--disable-write[disable non-shell workspace filesystem writes]'
    '--disable-shell[disable workspace shell execution]'
    '--enable-shell-tool[use the legacy shell tool instead of the managed platform shell]'
  )

  # clap requires `=` for the optional worktree mode on the root and `resume`.
  local -a tui_opts
  tui_opts=(
    $run_opts
    '(- *)'{-h,--help}'[print help]'
    '(- *)'{-V,--version}'[print version]'
    '--agents[supply one ephemeral agent-definition overlay]:agent definition JSON:'
    '(-w --worktree)'{-w=-,--worktree=-}'[session Git worktree; bare means create]:: :_muse__worktree_modes'
    '--echo-delay-ms[deterministic echo reply delay (echo provider only)]:milliseconds:'
  )

  _arguments -C \
    $tui_opts \
    '--last[(hidden) resume the most recent session in this workspace]' \
    '(-)1: :->command' \
    '(-)*::arg:->args' \
    && ret=0

  case $state in
    command)
      local -a commands
      commands=(
        'resume:resume a previous session (--last or <session-ref>)'
        'exec:run one prompt non-interactively (headless)'
        'config:validate enterprise configuration documents'
        'export:export a session transcript to a file'
        'trace:inspect a recorded session or run trace'
        'skills:list, inspect, enable, or disable skills'
        'sandbox:check or set up the OS sandbox'
        'schema:export the MSP wire schema (JSON Schema or TypeScript)'
        'serve:serve an MSP session host over stdio'
        'session-message:list or send cross-session messages'
        'mcp:log in to or out of an MCP server (OAuth)'
        'auth:store provider API credentials'
        'login:log in to a provider'
        'logout:remove stored provider credentials'
        'init:scaffold agent config in this workspace'
        'workflows:(hidden) list, save, run, or recover saved workflows'
      )
      _describe -t commands 'muse command' commands && ret=0
      ;;
    args)
      curcontext=${curcontext%:*:*}:muse-$words[1]:
      case $words[1] in
        resume)
          _arguments \
            $tui_opts \
            '--last[resume the most recent session in this workspace]' \
            '1:: :_muse__sessions' \
            && ret=0
          ;;
        exec)
          _arguments \
            $run_opts \
            '(- *)'{-h,--help}'[print help]' \
            '(-w --worktree)'{-w,--worktree}'[session git worktree; bare means create]' \
            '--agents[(hidden) supply one ephemeral agent-definition overlay]:agent definition JSON:' \
            '--json[emit machine-readable JSONL events on stdout]' \
            '--prompt-file[read the prompt from a file instead of an argument]:prompt file:_files' \
            '--api-key-stdin[read the provider API key from stdin]' \
            '(--eval-context-compaction-strategy)--context-compaction-strategy[context compaction strategy]: :_muse__compaction_strategies' \
            '--context-compaction-soft-threshold[soft compaction threshold]:fraction:' \
            '--context-compaction-hard-threshold[hard compaction threshold]:fraction:' \
            '(--context-compaction-strategy)--eval-context-compaction-strategy[(hidden) eval-only context compaction strategy]: :_muse__eval_compaction_strategies' \
            '--eval-workflow-api-version[(hidden) Workflow API version for evals]:version:(v1 v2)' \
            '--output-schema[shape the final answer with the JSON schema in FILE (meta provider only)]:JSON schema file:_files' \
            '--max-model-steps[cap the number of model steps]:steps:' \
            '--max-tool-output-bytes[cap tool output bytes fed back to the model (0 or >=9)]:bytes:' \
            '--session-id[use a specific session id]:session UUID:' \
            '--allow-workspace-switch[allow switching the workspace mid-run]' \
            '--user-input-auto-resolve[offer request_user_input and auto-cancel prompts (headless)]' \
            '--disable-web-tools[disable web tools for this run]' \
            '--no-foreign-personal-context[exclude foreign personal rules and skills from this run]' \
            '*:prompt:->exec_arg' \
            && ret=0
          # exec takes the word after -w as its mode only when it is a valid one.
          if [[ $state == exec_arg ]]; then
            if [[ $words[CURRENT-1] == (-w|--worktree) ]]; then
              _muse__worktree_modes && ret=0
            else
              _message 'prompt'
            fi
          fi
          ;;
        config)
          _muse__config && ret=0
          ;;
        export)
          _arguments \
            '(- *)--help[print help]' \
            '--session[session UUID or path to a session.jsonl file]: :_muse__session_or_log' \
            '--last[skip the picker and export the most recent session]' \
            '--out[write the document to this file]:output file:_files' \
            '--redacted[share-safe variant with telemetry redaction applied]' \
            && ret=0
          ;;
        trace)
          _muse__trace && ret=0
          ;;
        skills)
          _muse__skills_cmd && ret=0
          ;;
        sandbox)
          _muse__sandbox && ret=0
          ;;
        schema)
          _muse__schema && ret=0
          ;;
        serve)
          _arguments \
            '(- *)'{-h,--help}'[print help]' \
            '--no-session-log[use memory-only sessions]' \
            '--disable-sandbox[disable shell filesystem/network sandboxing for this host]' \
            '--sandbox-network[sandbox network mode]: :_muse__sandbox_network' \
            '--disable-write[disable non-shell workspace filesystem writes]' \
            '--disable-shell[disable workspace shell execution]' \
            '--trust-workspace[load each session workspace'\''s skills and rules]' \
            && ret=0
          ;;
        session-message)
          _muse__session_message && ret=0
          ;;
        mcp)
          _muse__mcp && ret=0
          ;;
        auth)
          _muse__auth && ret=0
          ;;
        login|logout)
          _arguments '(- *)--help[print help]' && ret=0
          ;;
        init)
          _arguments \
            '(- *)--help[print help]' \
            '--dry-run[print the scaffolded AGENTS.md instead of writing it]' \
            '--force[overwrite an existing AGENTS.md]' \
            && ret=0
          ;;
        workflows)
          _muse__workflows && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

(( $+functions[_muse__config] )) ||
_muse__config() {
  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args

  _arguments -C \
    '1: :->command' \
    '*::arg:->args' \
    && ret=0

  case $state in
    command)
      local -a commands
      commands=(
        'validate:validate an enterprise plane document'
        'status:show enterprise configuration status'
      )
      _describe -t commands 'muse config command' commands && ret=0
      ;;
    args)
      case $words[1] in
        validate)
          _arguments \
            '--plane[configuration plane the document belongs to]:plane:(defaults policy)' \
            '--file[enterprise plane document to validate]:document:_files' \
            && ret=0
          ;;
        status)
          _message 'no arguments'
          ;;
      esac
      ;;
  esac

  return ret
}

