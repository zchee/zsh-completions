(( $+functions[_muse__skills_cmd] )) ||
_muse__skills_cmd() {
  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args

  _arguments -C \
    '1: :->command' \
    '*::arg:->args' \
    && ret=0

  local -a common_opts
  common_opts=(
    '(- *)--help[print help]'
    '--workspace[workspace whose project skills to consider]:workspace:_directories'
    '--trust-workspace[trust the workspace for this run (load its skills)]'
    '--json[emit JSON]'
  )
  local source_spec='--source[which skill source to consider]:source:(all user project built-in plugin)'
  local scope_values='(user project built-in plugin)'

  case $state in
    command)
      local -a commands
      commands=(
        'list:list skills'
        'inspect:show one skill'
        'enable:enable a skill in a scope'
        'user-only:restrict a skill to user invocation in a scope'
        'disable:disable a skill in a scope'
        'validate:validate a skill directory or SKILL.md'
        'install:install a skill from a path'
        'import:import skills from Claude Code or Codex'
        'update:update an installed skill'
        'uninstall:uninstall an installed skill'
      )
      _describe -t commands 'muse skills command' commands && ret=0
      ;;
    args)
      case $words[1] in
        list)
          _arguments \
            $common_opts \
            $source_spec \
            '--enabled-only[list only enabled skills]' \
            "--scope[(hidden) restrict to one scope]:scope:$scope_values" \
            && ret=0
          ;;
        inspect)
          _arguments \
            $common_opts \
            $source_spec \
            "--scope[(hidden) restrict to one scope]:scope:$scope_values" \
            '--enabled-only[(hidden) consider only enabled skills]' \
            '1: :_muse__skill_or_path' \
            && ret=0
          ;;
        enable|user-only|disable)
          _arguments \
            $common_opts \
            "--scope[scope whose setting to change]:scope:$scope_values" \
            "--source[(hidden) which skill source to consider]:source:(all user project built-in plugin)" \
            '--enabled-only[(hidden) consider only enabled skills]' \
            '1: :_muse__skill_or_path' \
            && ret=0
          ;;
        validate)
          _arguments \
            '(- *)--help[print help]' \
            '--json[emit JSON]' \
            '1:skill path:_files' \
            && ret=0
          ;;
        install)
          _arguments \
            '(- *)--help[print help]' \
            '--scope[install scope]:scope:(user)' \
            '--name[install under this name]:name:' \
            '--force[overwrite an existing skill]' \
            '--json[emit JSON]' \
            '1:skill path:_files' \
            && ret=0
          ;;
        import)
          _arguments \
            '(- *)--help[print help]' \
            '--from[agent to import skills from]:agent:(claude codex)' \
            '--scope[import scope]:scope:(user)' \
            '--dry-run[show what would be imported without writing]' \
            '--force[overwrite existing skills]' \
            '--json[emit JSON]' \
            && ret=0
          ;;
        update)
          _arguments \
            '(- *)--help[print help]' \
            '--json[emit JSON]' \
            '1: :_muse__skills' \
            && ret=0
          ;;
        uninstall)
          _arguments \
            '(- *)--help[print help]' \
            '--keep-files[keep the skill files on disk]' \
            '--json[emit JSON]' \
            '1: :_muse__skills' \
            && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

