# 1.5.22 (add-skill)
#
# `add-skill` is not a second CLI.  package.json declares
#
#     "bin": { "skills": "./bin/cli.mjs", "add-skill": "./bin/cli.mjs" }
#
# and src/cli.ts dispatches purely on process.argv.slice(2) without ever reading
# argv[0], so `add-skill` accepts exactly the commands, aliases, hidden aliases
# and flags that `skills` does.  Rather than duplicate that surface (and let the
# two copies drift apart on the next release), this file forwards to _skills.
#
# _skills reads $service, so `_call_program` still shells out to `add-skill`
# here, and the completion contexts stay named after the invoked command.
#
# -----------------------------------------------------------------------------

_add-skill() {
  # compinit marks every _* file in $fpath autoloadable, so _skills is normally
  # already resolvable; the explicit autoload only covers a hand-sourced setup.
  (( $+functions[_skills] )) || autoload -Uz +X _skills 2>/dev/null

  if (( $+functions[_skills] )); then
    _skills "$@"
    return
  fi

  _message 'the _skills completion must be installed alongside _add-skill'
  return 1
}

_add-skill "$@"

