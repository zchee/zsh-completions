# 5.3.0 (Oh-My-ClaudeCode)
#
# Derived from `omc --help` walked breadth-first over every command path, then
# reconciled against the Commander definition the installed build runs from.
# Every option here was confirmed against the binary: strict Commander paths
# by ending a probe in an unknown sentinel flag
# (`omc <path> <flag> [value] --zz-definitely-not-a-flag`), which aborts in
# option parsing so no command action runs; the hand-parsed commands by
# calling the shipped extractors with a synthetic argv and checking which
# tokens they consume.
#
# Claude Code passthrough
# -----------------------
# Bare `omc <args>` and `omc launch <args>` strip only omc's own flags and
# forward everything else to `claude` verbatim -- the whole Claude Code
# command tree included, so `omc mcp list` really runs `claude mcp list`.
# Rather than copy that surface (it moves every Claude Code release), those
# two paths rewrite arg0 to `claude` and hand off to the `_claude` completion
# in this same directory. If `_claude` is not on `fpath`, the passthrough
# completes nothing and omc's own flags still work.
#
# Flag names are offered as two labelled groups, `-- omc option --` and
# `-- claude option --`, so a flag's owner is visible at a glance -- the same
# split the two command groups give. Claude's group is converted from
# `_claude__top_option_specs`, so it still tracks Claude Code releases and
# nothing is copied.
#
# Neither group may come from `_arguments`. An `_arguments` call sizes its
# description column from its own matches, so pairing its option listing with
# any other group drops the descriptions past roughly 120 terminal columns
# (measured: fine at 80, names only at 200). And `_describe` alone is not
# enough either -- zsh picks a compact display for a large multi-group
# listing at that width. Both groups therefore go through `compadd -l` with a
# pre-formatted display string, which pins one match per line and keeps the
# descriptions at any width. Values, subcommands and positionals still go
# through `_claude` and its `_arguments`, where arity and exclusions belong.
#
# The cost of leaving `_arguments` for flag NAMES is that a flag already on
# the line is still offered, and completing `--mo` does not append the `=`.
#
# That is also why `_omc__claude_delegate` reports only whether `_claude` was
# available and never its exit status: `_claude` returns non-zero whenever
# the current word matches nothing it offers, and treating that as failure
# would run the fallback `_arguments` as a second pass.
#
# Values for omc's own flags are completed before the hand-off, since Claude
# knows nothing about them. `--notify` takes the next word or an inline `=`;
# the other five are inline-only (`--telegram=false`).
#
# Items marked "(hidden)" are accepted but absent from every `--help`:
#   * commands:  postinstall  (registered with { hidden: true })
#   * root and launch: --openclaw --telegram --discord --slack --webhook
#     -- hand-parsed, presence-based, and each also accepts an inline
#     `=true|false|1|0`; never a space-separated value
#   * team:      --fixed-workers --preformed-plan  (undocumented aliases for
#     --no-decompose, all three set the same flag)
#
# `--madmax` and `--yolo` are documented only inside the launch help Examples
# block, never as options, so a parser that reads the Options: section alone
# reports them as hidden.
#
# Deliberately not completed: `omc autoresearch`'s legacy flags. The command
# is now a hard-deprecated shim that accepts any argument and only prints a
# migration message, so completing `--mission`/`--eval`/`--resume` would
# advertise a runtime that no longer exists.
#
# `omc ultragoal` and `omc alias-retirement` set helpOption(false) and parse
# their own argv, so their surface comes from their hand-written help text,
# not from Commander.
#
# -----------------------------------------------------------------------------

_omc__message() {
  _message "${1:-value}"
}

_omc__prompt_text() {
  _omc__message 'prompt text'
}

_omc__shift_words() {
  local shift_count=$1
  local -a shifted
  local index

  shifted=()
  for (( index = shift_count + 1; index <= ${#words}; index++ )); do
    shifted+=("${words[index]}")
  done

  reply=("${shifted[@]}")
  REPLY=$(( CURRENT - shift_count ))
  (( REPLY < 1 )) && REPLY=1
}

_omc__bool_values() {
  local -a values
  values=(
    'true:enable'
    'false:disable'
    '1:enable'
    '0:disable'
  )
  _describe 'boolean' values
}

_omc__complete_help_only_leaf() {
  _omc__shift_words "${1:-1}"
  words=("${reply[@]}")
  CURRENT=$REPLY
  _arguments -s '(-h --help)'{-h,--help}'[display help for command]'
}

_omc__complete_json_help_leaf() {
  _omc__shift_words "${1:-1}"
  words=("${reply[@]}")
  CURRENT=$REPLY
  _arguments -s \
    '--json[output as JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]'
}

_omc__describe_static_items() {
  local description=$1
  shift
  local -a items
  items=("$@")
  _describe "$description" items
}

# Rewrite `words` for the Claude Code passthrough. Only arg0 changes: omc's
# own flags are handed to `_claude` too, as injected option specs, so its
# single `_arguments` call parses the whole line and nothing has to be
# stripped here. words[1] is `omc`, or `launch` after the dispatcher's shift.
_omc__claude_words() {
  reply=("${words[@]}")
  reply[1]=claude
  REPLY=$CURRENT
}

# Hand the line to the `_claude` completion, with omc's own root option specs
# injected so both flag sets are produced by one `_arguments` call. Returns
# non-zero when `_claude` is not on `fpath`, so callers can fall back.
_omc__claude_delegate() {
  (( $+functions[_claude] )) || return 1

  _omc__claude_words
  words=("${reply[@]}")
  CURRENT=$REPLY
  _claude

  # Report only whether `_claude` was available, never its own exit status:
  # it returns non-zero whenever the current word matched nothing it offers,
  # and a caller that treated that as "delegation failed" would run its own
  # `_arguments` as well. Two passes writing into one listing disagree about
  # column widths, and past roughly 120 columns the descriptions end up
  # stacked below the names instead of beside them.
  return 0
}

