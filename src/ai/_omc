_omc__complete_root() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  # a value for one of omc's own flags is omc's to complete, not Claude's
  _omc__launch_option_values && return

  # completing a flag name: two `_describe` groups, so the owner of each flag
  # is visible and both keep their descriptions
  if [[ "${words[CURRENT]}" == -* ]]; then
    _omc__launch_option_descriptions '-V:output the version number'
    _omc__claude_option_descriptions && return

    # no `_claude` on fpath: omc's own flags are all there is
    _omc__launch_option_specs
    _arguments -s \
      "${reply[@]}" \
      '-V[output the version number]' \
      '(-h --help)'{-h,--help}'[display help for command]'
    return
  fi

  # omc's own subcommands belong in the command slot only
  (( CURRENT == 2 )) && _omc__top_commands

  _omc__claude_delegate
}

_omc__complete_launch_like() {
  local shift_count=${1:-0}
  local curcontext="$curcontext" state line
  typeset -A opt_args

  if (( shift_count > 0 )); then
    _omc__shift_words "$shift_count"
    words=("${reply[@]}")
    CURRENT=$REPLY
  fi

  _omc__launch_option_values && return

  if [[ "${words[CURRENT]}" == -* ]]; then
    _omc__launch_option_descriptions
    _omc__claude_option_descriptions && return

    _omc__launch_option_specs
    _arguments -s \
      "${reply[@]}" \
      '(-h --help)'{-h,--help}'[display help for command]'
    return
  fi

  _omc__claude_delegate
}

