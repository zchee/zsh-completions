_omc__complete_team() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _omc__shift_words 1
  words=("${reply[@]}")
  CURRENT=$REPLY

  case $words[2] in
    api)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _omc__complete_team_api
      return
      ;;
    status)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments \
        '1:team name:_omc__team_names'
      return
      ;;
    shutdown)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments -s \
        '(-f --force)'{-f,--force}'[force shutdown]' \
        '1:team name:_omc__team_names'
      return
      ;;
    help|-h|--help)
      _omc__team_commands
      return
      ;;
  esac

  _arguments -C -s \
    '--new-window[launch the team in a new tmux window]' \
    '1:team command or worker spec:->first' \
    '*::team argument:->rest'

  case $state in
    first)
      _alternative \
        'commands:team command:_omc__team_commands' \
        'worker specs:team worker specification:_omc__team_agent_spec'
      ;;
    rest)
      if (( CURRENT <= 3 )); then
        _omc__team_agent_spec
      else
        _omc__message 'task description'
      fi
      ;;
  esac
}

_omc__complete_autoresearch() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _omc__shift_words 1
  words=("${reply[@]}")
