# Hidden root command, registered with { hidden: true }.
_omc__complete_postinstall() {
  _omc__complete_help_only_leaf 1
}

function _omc() {
  case $words[2] in
    ''|-*)
      _omc__complete_root
      ;;
    launch)
      _omc__complete_launch_like 1
      ;;
    interop)
      _omc__complete_info
      ;;
    ask)
      _omc__complete_ask
      ;;
    config)
      _omc__complete_config
      ;;
    config-stop-callback)
      _omc__complete_config_stop_callback
      ;;
    config-notify-profile)
      _omc__complete_config_notify_profile
      ;;
    info)
      _omc__complete_info
      ;;
    test-prompt)
      _omc__complete_test_prompt
      ;;
    update)
      _omc__complete_update
      ;;
    update-reconcile)
      _omc__complete_update_reconcile
      ;;
    version)
      _omc__complete_version
      ;;
    install)
      _omc__complete_install
      ;;
    wait)
      _omc__complete_wait
      ;;
    teleport)
      _omc__complete_teleport
      ;;
    session|sessions)
      _omc__complete_session_like
      ;;
    capabilities)
      _omc__complete_capabilities
      ;;
    doctor)
      _omc__complete_doctor
      ;;
    setup)
      _omc__complete_setup
      ;;
    hud)
      _omc__complete_hud
      ;;
    mission-board)
      _omc__complete_mission_board
      ;;
    team)
      _omc__complete_team
      ;;
    autoresearch)
      _omc__complete_autoresearch
      ;;
    ralphthon)
      _omc__complete_ralphthon
      ;;
    ultragoal)
      _omc__complete_ultragoal
      ;;
    alias-retirement)
