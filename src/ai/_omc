_omc__team_agent_spec() {
  local cur fragment prefix count agent_type
  local -a agent_types roles
  cur="${words[CURRENT]}"
  prefix=''
  fragment="$cur"

  agent_types=(claude codex gemini grok cursor antigravity)
  roles=(
    architect executor planner analyst critic debugger verifier
    code-reviewer security-reviewer test-engineer designer writer scientist
  )

  if [[ $fragment == *,* ]]; then
    prefix="${fragment%,*},"
    fragment="${fragment##*,}"
  fi

  if [[ $fragment == <->: ]]; then
    compadd -Q -S '' -- "${agent_types[@]/#/${prefix}${fragment}}"
    return
  fi

  if [[ $fragment == <->:* && $fragment != *:*:* ]]; then
    count="${fragment%%:*}"
    compadd -Q -S '' -- "${agent_types[@]/#/${prefix}${count}:}"
    return
  fi

  if [[ $fragment == <->:*:* ]]; then
    count="${fragment%%:*}"
    agent_type="${fragment#*:}"
    agent_type="${agent_type%%:*}"
    compadd -Q -S '' -- "${roles[@]/#/${prefix}${count}:${agent_type}:}"
    return
  fi

  compadd -Q -S '' -- \
    "${agent_types[@]/#/1:}" \
    "${agent_types[@]/#/2:}" \
    "${agent_types[@]/#/3:}"
}

# omc's own launch-time flags: consumed by omc, never forwarded to claude.
#
# `--notify` takes its value as the next word or after `=`, and only the
# tokens true/false/1/0 are consumed. The other five are presence-based: the
# value is optional and inline-only, which is `=-` plus `::` -- with a single
# `:` zsh treats the value as mandatory and appends a stray second `=` to the
# buffer.
#
# `-h`/`--help` are deliberately absent: claude declares them too, and a
# duplicate spec in the merged `_arguments` call would collide. The fallback
# path used when `_claude` is missing adds them back.
# omc's own flags as their own completion group, so `omc --<TAB>` shows them
# under `-- omc option --` rather than mixed into Claude's `-- option --`.
#
# These go through `_describe`, NOT a second `_arguments` call. Two
# `_arguments` passes writing into one match listing size their description
# columns independently and, past roughly 120 terminal columns, the
# descriptions end up stacked below the names. Two `_describe` groups lay out
# independently and correctly -- the same reason the two command groups
# render cleanly.
_omc__launch_option_descriptions() {
  local -a opts
  opts=(
    '--notify:enable or disable CCNotifier events'
    '--madmax:alias for --dangerously-skip-permissions'
    '--yolo:alias for --dangerously-skip-permissions'
    '--openclaw:(hidden) enable or disable OpenClaw mode'
    '--telegram:(hidden) enable or disable Telegram notifications'
    '--discord:(hidden) enable or disable Discord notifications'
    '--slack:(hidden) enable or disable Slack notifications'
    '--webhook:(hidden) enable or disable webhook notifications'
  )
  (( $# )) && opts+=("$@")
  _omc__add_option_group omc-options 'omc option' "${opts[@]}"
}

# Values for the omc-only flags. `--notify` takes the next word or an inline
# `=`; the other five are inline-only.
_omc__launch_option_values() {
  case "${words[CURRENT]}" in
    (--notify=*|--openclaw=*|--telegram=*|--discord=*|--slack=*|--webhook=*)
      compset -P '*='
      _omc__bool_values
      return 0
      ;;
  esac

  if [[ "${words[CURRENT-1]}" == --notify ]]; then
    _omc__bool_values
    return 0
  fi

  return 1
}

# Add one completion group of `name:description` entries.
#
# `_describe` would be shorter, but zsh drops the descriptions from a large
# MULTI-group listing once the terminal is wide (measured: fine at 80
# columns, names only at 200). `compadd -l` forces one match per line and a
# pre-formatted display string carries the description, so the two groups keep
# their descriptions at any width. Padding is per group, which is also why
# each group stays internally aligned.
_omc__add_option_group() {
  local tag=$1 descr=$2
  shift 2

  local -a names displays
  local item name desc
  local -i width=0

  for item in "$@"; do
    name="${item%%:*}"
    (( ${#name} > width )) && width=${#name}
  done

  for item in "$@"; do
    name="${item%%:*}"
    desc="${item#*:}"
    names+=("$name")
    displays+=("${(r:$width:)name}  -- ${desc}")
  done

  local expl
  _wanted "$tag" expl "$descr" compadd -l -d displays -a names
}

# Claude's root flags as a `-- claude option --` group, converted from
# `_claude__top_option_specs`.
#
# When a flag NAME is being completed both groups have to come from
# `_describe`. `_arguments`' own option listing sizes its description column
# from its own matches, so pairing it with any other group drops the
# descriptions from the listing past roughly 120 terminal columns. Values,
# subcommands and everything else still go through `_claude` and its
# `_arguments`, which is where exclusions and arity belong.
# `_claude__top_option_specs` only exists once the `_claude` file has been
# sourced, and `autoload +X` defines just `_claude` itself. Source the file
# with its trailing run suppressed to get the helper tables.
_omc__ensure_claude_tables() {
  (( $+functions[_claude__top_option_specs] )) && return 0

  local -a files
  files=(${^fpath}/_claude(N))
  (( ${#files} )) || return 1

  local _claude_source_only=1
  source "${files[1]}" 2>/dev/null

  (( $+functions[_claude__top_option_specs] ))
}

_omc__claude_option_descriptions() {
  _omc__ensure_claude_tables || return 1

  local -a specs opts
  local spec flag desc

  _claude__top_option_specs
  specs=("${reply[@]}")

  for spec in "${specs[@]}"; do
    # a leading `*` marks a repeatable option; `(...)` lists what it excludes
    spec="${spec#\*}"
    while [[ $spec == '('* ]]; do
      spec="${spec#*\)}"
    done

    # the description opens at the first UNESCAPED `[`, and the text itself
    # may contain `\[` / `\]`, so park the escaped ones out of the way first
    spec="${spec//\\\[/$'\1'}"
    spec="${spec//\\\]/$'\2'}"
    [[ $spec == *'['* ]] || continue

    flag="${spec%%\[*}"
    desc="${spec#*\[}"
    desc="${desc%%\]*}"

    # `=`, `=-` and `+` say where the value goes, not part of the name
    flag="${flag%%[=+]*}"
    [[ -n $flag ]] || continue

    desc="${desc//$'\1'/\[}"
    desc="${desc//$'\2'/\]}"
    desc="${desc//\\:/:}"

    opts+=("${flag}:${desc}")
  done

