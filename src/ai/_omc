_omc__complete_wait() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _omc__shift_words 1
  words=("${reply[@]}")
  CURRENT=$REPLY

  case $words[2] in
    status)
      _omc__complete_json_help_leaf 1
      return
      ;;
    daemon)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments -C -s \
        '(-v --verbose)'{-v,--verbose}'[enable verbose logging]' \
        '(-f --foreground)'{-f,--foreground}'[run in the foreground]' \
        '(-i --interval)'{-i,--interval}'[poll interval in seconds]:seconds' \
        '1:action:_omc__wait_daemon_actions' \
        '(-h --help)'{-h,--help}'[display help for command]'
      return
      ;;
    detect)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments -s \
        '--json[output as JSON]' \
        '(-l --lines)'{-l,--lines}'[number of pane lines to analyze]:number' \
        '(-h --help)'{-h,--help}'[display help for command]'
      return
      ;;
  esac

  _arguments -C -s \
    '--json[output as JSON]' \
    '--start[start the auto-resume daemon]' \
    '--stop[stop the auto-resume daemon]' \
    '1:wait command:->command' \
    '(-h --help)'{-h,--help}'[display help for command]'

  case $state in
    command)
      _omc__wait_commands
      ;;
  esac
}

