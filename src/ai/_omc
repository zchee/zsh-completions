    '--current-version=[override the current package version]:semver: _omc__message "semver"'
    '--now=[override the evaluation time]:ISO-8601: _omc__message "ISO-8601 timestamp"'
    '--usage-history=[alias usage history JSON or a path to it]:json or path:_files'
    '--critical-integrations=[known critical consumers JSON or a path to it]:json or path:_files'
    '--check-eligible[exit 2 when any alias is eligible for retirement]'
    '(-h --help)'{-h,--help}'[show help]'
  )

  case $words[2] in
    verify)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments -s "${verify_specs[@]}"
      return
      ;;
    help)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments '1:alias-retirement command:_omc__alias_retirement_commands'
      return
      ;;
  esac

  _arguments -C -s \
    "${verify_specs[@]}" \
    '1:alias-retirement command:->command'

  case $state in
    command)
      _omc__alias_retirement_commands
      ;;
  esac
}

_omc__complete_graph() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _omc__shift_words 1
  words=("${reply[@]}")
  CURRENT=$REPLY

  case $words[2] in
    run)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments -s \
        '--runs-root=[directory holding per-run state]:directory:_files -/' \
        '--approval-mode=[approval gate style]:mode:(stdin remote)' \
        '--approval-timeout=[remote approvals\: max seconds to wait]:seconds' \
        '--approval-timeout-policy=[resolution for an expired request]:policy:(deny approve)' \
        '--checkpoint[snapshot the working tree before the run]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1:descriptor:_files'
      return
      ;;
    approvals)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY

      case $words[2] in
        list)
          _omc__shift_words 1
          words=("${reply[@]}")
          CURRENT=$REPLY
          _arguments -s \
            '--runs-root=[directory holding per-run state]:directory:_files -/' \
            '(-h --help)'{-h,--help}'[display help for command]'
          return
          ;;
        decide)
          _omc__shift_words 1
          words=("${reply[@]}")
          CURRENT=$REPLY
          _arguments -C -s \
            '--runs-root=[directory holding per-run state]:directory:_files -/' \
            '--by=[record who made the decision]:who: _omc__message "who"' \
            '--rollback=[roll the working tree back to a checkpoint after a denial]:checkpoint:_omc__checkpoint_ids' \
            '--force[with --rollback\: discard changes made after the checkpoint]' \
            '(-h --help)'{-h,--help}'[display help for command]' \
            '1:run id:_omc__graph_run_ids' \
            '2:activation id: _omc__message "activation id"' \
            '3:decision:(approved denied)'
          return
          ;;
        help)
          _omc__shift_words 1
          words=("${reply[@]}")
          CURRENT=$REPLY
          _arguments '1:approvals command:_omc__graph_approvals_commands'
          return
          ;;
      esac

      _arguments -C -s \
        '1:approvals command:->command' \
        '(-h --help)'{-h,--help}'[display help for command]'

      case $state in
        command)
          _omc__graph_approvals_commands
          ;;
      esac
      return
      ;;
    help)
      _omc__shift_words 1
      words=("${reply[@]}")
      CURRENT=$REPLY
      _arguments '1:graph command:_omc__graph_commands'
      return
      ;;
  esac

  _arguments -C -s \
    '1:graph command:->command' \
    '(-h --help)'{-h,--help}'[display help for command]'

  case $state in
    command)
      _omc__graph_commands
      ;;
  esac
}

