}

_omc__complete_ask() {
  local prev

  _omc__shift_words 1
  words=("${reply[@]}")
  CURRENT=$REPLY
  prev="${words[CURRENT-1]}"

  if (( CURRENT == 2 )); then
    local -a providers
    providers=(
      'claude:use Claude as the advisor provider'
      'codex:use Codex as the advisor provider'
      'gemini:use Gemini as the advisor provider'
    )
    _describe 'provider' providers
    return
  fi

  case $prev in
    --agent-prompt)
      _omc__ask_agent_roles
      return
      ;;
  esac

  _arguments -C -s \
    '--agent-prompt=[prepend an agent prompt role before the task]:role:_omc__ask_agent_roles' \
    '(-p --print --prompt)'{-p,--print,--prompt}'[treat the remaining text as the prompt]:prompt text:_omc__prompt_text' \
    '*::prompt text:_omc__prompt_text'
}

function _omc() {
  case $words[2] in
    ''|-*)
      _omc__complete_root
      ;;
    launch)
      _omc__complete_launch_like 2
      ;;
    interop)
      _omc__complete_info
      ;;
    ask)
      _omc__complete_ask
      ;;
    config)
      _omc__complete_config
      ;;
    config-stop-callback)
      _omc__complete_config_stop_callback
      ;;
    config-notify-profile)
      _omc__complete_config_notify_profile
      ;;
    info)
      _omc__complete_info
      ;;
    test-prompt)
      _omc__complete_test_prompt
      ;;
    update)
      _omc__complete_update
      ;;
    update-reconcile)
      _omc__complete_update_reconcile
      ;;
    version)
      _omc__complete_version
      ;;
    install)
      _omc__complete_install
      ;;
    wait)
      _omc__complete_wait
      ;;
    teleport)
      _omc__complete_teleport
      ;;
    session|sessions)
      _omc__complete_session_like
      ;;
    doctor)
      _omc__complete_doctor
      ;;
    setup)
      _omc__complete_setup
      ;;
    hud)
      _omc__complete_hud
      ;;
    mission-board)
      _omc__complete_mission_board
      ;;
    team)
      _omc__complete_team
      ;;
    autoresearch)
      _omc__complete_autoresearch
      ;;
    ralphthon)
      _omc__complete_ralphthon
      ;;
    *)
      _omc__complete_root
      ;;
  esac
}

_omc "$@"

