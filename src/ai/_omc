_omc__collect_ask_agent_roles() {
  local -a dirs files roles
  local dir file

  dirs=(
    "./prompts"
    "./.codex/prompts"
    "${CODEX_HOME:-$HOME/.codex}/prompts"
    "/opt/local/var/bun/install/global/node_modules/oh-my-claude-sisyphus/agents"
  )

  roles=()
  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue
    files=($dir/*.md(N))
    for file in "${files[@]}"; do
      roles+=("${file:t:r}")
    done
  done

  if (( ! $#roles )); then
    roles=(
      analyst architect critic debugger designer executor explorer planner
      scientist security-reviewer test-engineer verifier writer
    )
  fi

  reply=(${(ou)roles})
}

_omc__ask_agent_roles() {
  local -a roles

  _omc__collect_ask_agent_roles
  roles=("${reply[@]}")
  _describe 'agent prompt role' roles
}

_omc__collect_team_names() {
  local -a paths names
  local path

  paths=(.omc/state/team/*(/N))
  names=()
  for path in "${paths[@]}"; do
    names+=("${path:t}")
  done

  reply=(${(ou)names})
}

_omc__team_names() {
  local -a names

  _omc__collect_team_names
  names=("${reply[@]}")

  if (( $#names )); then
    _describe 'team' names
  else
    _omc__message 'team name'
  fi
}

_omc__git_branches() {
  local current_branch line name desc
  local -a lines branches

  command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    _message 'git branch'
    return
  }

  current_branch=$(command git symbolic-ref --quiet --short HEAD 2>/dev/null)
  lines=("${(@f)$(command git for-each-ref --format='%(refname:short)%09%(refname)' refs/heads refs/remotes 2>/dev/null)}")
  branches=()

  for line in "${lines[@]}"; do
    name="${line%%$'\t'*}"
    [[ -n $name && $name != */HEAD ]] || continue

    if [[ ${line#*$'\t'} == refs/heads/* ]]; then
      desc='local branch'
      [[ $name == $current_branch ]] && desc='current branch'
    else
      desc='remote branch'
    fi

    branches+=("${name}:${desc}")
  done

  if (( $#branches )); then
    _describe 'git branch' branches
  else
    _message 'git branch'
  fi
}

# `omc checkpoint list` prints "<id>  <createdAt>  <label>" per checkpoint, or
# "No checkpoints." when there are none. Local git shadow commits, ~0.2 s, no
# network, so no cache file.
_omc__checkpoint_ids() {
  local -a entries ids
  local line id rest

  entries=(${(f)"$(_call_program checkpoint-ids omc checkpoint list 2>/dev/null)"})

  for line in "${entries[@]}"; do
    [[ $line == 'No checkpoints.'* ]] && continue
    id="${line%%[[:space:]]*}"
    [[ -n $id ]] || continue
    rest="${line#$id}"
    rest="${rest##[[:space:]]##}"
    ids+=("${id}:${rest:-checkpoint}")
  done

  if (( ${#ids} == 0 )); then
    _omc__message 'checkpoint id'
    return
  fi
  _describe 'checkpoint' ids
}

