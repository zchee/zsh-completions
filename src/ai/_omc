_omc__team_agent_spec() {
  local cur fragment prefix count agent_type
  cur="${words[CURRENT]}"
  prefix=''
  fragment="$cur"

  if [[ $fragment == *,* ]]; then
    prefix="${fragment%,*},"
    fragment="${fragment##*,}"
  fi

  if [[ $fragment == <->: ]]; then
    compadd -Q -S '' -- \
      "${prefix}${fragment}claude" \
      "${prefix}${fragment}codex" \
      "${prefix}${fragment}gemini"
    return
  fi

  if [[ $fragment == <->:* && $fragment != *:*:* ]]; then
    count="${fragment%%:*}"
    compadd -Q -S '' -- \
      "${prefix}${count}:claude" \
      "${prefix}${count}:codex" \
      "${prefix}${count}:gemini"
    return
  fi

  if [[ $fragment == <->:*:* ]]; then
    count="${fragment%%:*}"
    agent_type="${fragment#*:}"
    agent_type="${agent_type%%:*}"
    compadd -Q -S '' -- \
      "${prefix}${count}:${agent_type}:architect" \
      "${prefix}${count}:${agent_type}:executor" \
      "${prefix}${count}:${agent_type}:planner" \
      "${prefix}${count}:${agent_type}:analyst" \
      "${prefix}${count}:${agent_type}:critic" \
      "${prefix}${count}:${agent_type}:debugger" \
      "${prefix}${count}:${agent_type}:verifier" \
      "${prefix}${count}:${agent_type}:code-reviewer" \
      "${prefix}${count}:${agent_type}:security-reviewer" \
      "${prefix}${count}:${agent_type}:test-engineer" \
      "${prefix}${count}:${agent_type}:designer" \
      "${prefix}${count}:${agent_type}:writer" \
      "${prefix}${count}:${agent_type}:scientist"
    return
  fi

  compadd -Q -S '' -- \
    '1:claude' '1:codex' '1:gemini' \
    '2:claude' '2:codex' '2:gemini' \
    '1:codex:architect' '1:codex:executor' '1:codex:planner' \
    '1:gemini:analyst' '1:claude:critic'
}

