_omc__message() {
  _message "${1:-value}"
}

_omc__prompt_text() {
  _omc__message 'prompt text'
}

_omc__shift_words() {
  local shift_count=$1
  local -a shifted
  local index

  shifted=()
  for (( index = shift_count + 1; index <= ${#words}; index++ )); do
    shifted+=("${words[index]}")
  done

  reply=("${shifted[@]}")
  REPLY=$(( CURRENT - shift_count ))
  (( REPLY < 1 )) && REPLY=1
}

_omc__bool_values() {
  local -a values
  values=(
    'true:enable'
    'false:disable'
    '1:enable'
    '0:disable'
  )
  _describe 'boolean' values
}


_omc__complete_help_only_leaf() {
  _omc__shift_words "${1:-1}"
  words=("${reply[@]}")
  CURRENT=$REPLY
  _arguments -s '(-h --help)'{-h,--help}'[display help for command]'
}

_omc__complete_json_help_leaf() {
  _omc__shift_words "${1:-1}"
  words=("${reply[@]}")
  CURRENT=$REPLY
  _arguments -s \
    '--json[output as JSON]' \
    '(-h --help)'{-h,--help}'[display help for command]'
}

