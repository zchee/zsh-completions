      _arguments -s \
        '--topic[seed the guided setup with a topic]:topic:_omc__message' \
        '--eval[evaluator command]:command:_omc__message' \
        '--keep-policy[keep policy]:policy:_omc__keep_policy_values' \
        '--slug[custom mission slug]:slug:_omc__message' \
        '(-h --help)'{-h,--help}'[display help for command]'
      return
      ;;
    help|-h|--help)
      return
      ;;
  esac

  _arguments -C -s \
    '--topic[seed the guided intake with a topic]:topic:_omc__message' \
    '--evaluator[evaluator command for guided intake]:command:_omc__message' \
    '--mission[bypass interview with raw mission text]:mission text:_omc__message' \
    '--eval[bypass interview with evaluator command]:command:_omc__message' \
    '--sandbox[backward-compatible alias for --eval]:command:_omc__message' \
    '--keep-policy[keep policy]:policy:_omc__keep_policy_values' \
    '--slug[custom run slug]:slug:_omc__message' \
    '--resume[resume an existing run]:run id:_omc__autoresearch_run_ids' \
    '1:mission directory or init:->target' \
    '*::claude argument:_omc__message'

  case $state in
    target)
      _alternative \
        'subcommands:autoresearch subcommand:(init)' \
        'mission dirs:mission directory:_omc__mission_dirs'
      ;;
  esac
}

