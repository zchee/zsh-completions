_omc__complete_root() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a launch_specs claude_specs

  _omc__launch_option_specs
  launch_specs=("${reply[@]}")
  _omc__claude_option_specs
  claude_specs=("${reply[@]}")

  _arguments -C -s \
    '(-V --version)'{-V,--version}'[output the version number]' \
    ${launch_specs[@]} \
    ${claude_specs[@]} \
    '1:omc command:->command' \
    '*::launch argument:_omc__prompt_text'

  case $state in
    command)
      _omc__top_commands
      ;;
  esac
}

_omc__complete_launch_like() {
  local shift_count=${1:-0}
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a launch_specs claude_specs

  if (( shift_count > 0 )); then
    _omc__shift_words "$shift_count"
    words=("${reply[@]}")
    CURRENT=$REPLY
  fi

  _omc__launch_option_specs
  launch_specs=("${reply[@]}")
  _omc__claude_option_specs
  claude_specs=("${reply[@]}")

  _arguments -C -s \
    ${launch_specs[@]} \
    ${claude_specs[@]} \
    '1:claude command:->command' \
    '*::claude argument:_omc__prompt_text'

  case $state in
    command)
      _omc__claude_commands
      ;;
  esac
}

