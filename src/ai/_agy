#
# agy 1.4.3 (Google Antigravity CLI)
#
# Source of truth: `agy --help` and `agy <cmd> --help`, plus the flags those
# never print. Entries marked `(hidden)` are accepted by agy 1.4.3 but appear
# in no `--help` output.
#
# 1.4.3 over 1.2.8: `--effort` gained `xhigh` and `max`, `--mode` gained
# `auto`; `agy plugin list` takes `--json` and `agy plugin validate` takes
# `--strict` and `--json`. New hidden globals: `--remote-agent`,
# `--read_host_bridge_token_from_stdin` and three `--protosanitizer_*`
# switches. `--host_bridge_token` was removed. Projects moved from
# `<gemini_dir>/projects.json` to one file per project under
# `<gemini_dir>/config/projects/`, and plain `agy plugin list` is no longer
# JSON, so both dynamic helpers read the new sources.
#
# `agy --help` lists all twelve top-level subcommands and `agy plugin` all
# nine of its verbs. The hidden subcommands are:
#   - `agy remote-control serve`, the foreground daemon that `start` registers
#     with launchd/systemd. It takes no options of its own (the daemon's
#     global flags go before `remote-control`) and refuses to run before
#     sign-in.
#   - `help` under `agy mcp` and `agy remote-control`, which prints the same
#     usage text as `-h`.
# The single hidden subcommand option is `agy plugin import --force`, named
# only in the "already imported, use --force to re-import" line.
#
# Where `-h`/`--help` is actually accepted differs per subcommand, and agy is
# unforgiving about it:
#   - `agent`, `agents`, `changelog`, `models`, `install`, `mic-serve`,
#     every `mcp` verb and `remote-control start|status|stop` accept them.
#   - `agy plugin`, `agy mcp` and `agy remote-control` accept them as aliases
#     for their usage text.
#   - `agy update` defines no flags at all and rejects `-h` outright.
#   - `agy help` reads its first word as a subcommand name, so `-h` comes back
#     as `unknown subcommand: -h`.
#   - the `plugin` verbs parse no flags except `list --json`,
#     `validate --strict --json` and `import --force`: `agy plugin uninstall
#     -h` tries to uninstall a plugin literally named `-h`, and `list` and
#     `validate` reject `-h` as an unknown option.
# None of those exceptions are offered below.
#
# -----------------------------------------------------------------------------

_agy__message() {
  _message "${1:-value}"
}

# Value of a root option on the command line, or nothing. `_agy` saves the
# whole line in `_agy_line` before dispatching, because a subcommand's
# `$words` no longer holds the root options.
_agy__root_option() {
  local -a line
  local -i i
  local value
  line=( "${(@)_agy_line:-${(@)words}}" )
  for (( i = 1; i <= ${#line}; i++ )); do
    case ${line[i]} in
      --$1=*) value="${(Q)line[i]#--$1=}"; break ;;
      --$1)   value="${(Q)line[i+1]}"; break ;;
    esac
  done
  [[ ${value} == \~(/*|) ]] && value="${HOME}${value#\~}"
  print -r -- "${value}"
}

# Directory that holds agy state. `--gemini_dir` on the current command line
# wins, otherwise the built-in default. A relative value resolves against
# $HOME, as agy does.
_agy__gemini_dir() {
  local dir
  dir="$(_agy__root_option gemini_dir)"
  if [[ -z ${dir} ]]; then
    dir="${HOME}/.gemini"
  elif [[ ${dir} != /* ]]; then
    dir="${HOME}/${dir}"
  fi
  print -r -- "${dir}"
}

# Application data directory, `--app_data_dir` relative to the Gemini dir.
_agy__app_data_dir() {
  local dir gemini_dir
  gemini_dir="$(_agy__gemini_dir)"
  dir="$(_agy__root_option app_data_dir)"
  if [[ -z ${dir} ]]; then
    dir="${gemini_dir}/antigravity-cli"
  elif [[ ${dir} != /* ]]; then
    dir="${gemini_dir}/${dir}"
  fi
  print -r -- "${dir}"
}

# State-directory flags from the command line, quoted for `_call_program`, so
# helper commands read the same state as the command being completed.
_agy__state_args() {
  local value
  reply=()
  value="$(_agy__root_option gemini_dir)"
  [[ -n ${value} ]] && reply+=( "--gemini_dir=${(q)value}" )
  value="$(_agy__root_option app_data_dir)"
  [[ -n ${value} ]] && reply+=( "--app_data_dir=${(q)value}" )
}

# `agy models` reaches the network and takes a few seconds, so its result is
# kept in a small on-disk cache. Tune the lifetime (seconds) with
#   zstyle ':completion:*:*:agy:*' agy-models-ttl 3600
# and force a refresh by removing the cache file.
#
# Output is "<id>\t<display name>" on stdout; the progress note goes to stderr.
_agy__models() {
  local cache_file ttl
  local -a lines models mtime

  zstyle -s ":completion:${curcontext}:" agy-models-ttl ttl || ttl=86400
  cache_file="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh-completions/agy-models"

  zmodload -F zsh/stat b:zstat 2>/dev/null
  zmodload zsh/datetime 2>/dev/null

  if [[ -s ${cache_file} ]]; then
    zstat -A mtime +mtime -- ${cache_file} 2>/dev/null
    if (( ${#mtime} && EPOCHSECONDS - mtime[1] < ttl )); then
      models=( ${(f)"$(< ${cache_file})"} )
    fi
  fi

  if (( ! ${#models} )); then
    _agy__state_args
    lines=( ${(f)"$(_call_program models agy ${reply} models 2>/dev/null </dev/null)"} )
    models=( ${${lines:#}//$'\t'/:} )
    if (( ${#models} )); then
      mkdir -p -- ${cache_file:h} 2>/dev/null &&
        print -rl -- ${models} >| ${cache_file} 2>/dev/null
    fi
  fi

  if (( ${#models} )); then
    _describe -t models 'model' models
  else
    _agy__message 'model id'
  fi
}

_agy__agents() {
  local -a lines agents

  _agy__state_args
  lines=( ${(f)"$(_call_program agents agy ${reply} agent 2>/dev/null </dev/null)"} )
  agents=( ${${lines:#}//$'\t'/:} )

  if (( ${#agents} )); then
    _describe -t agents 'agent' agents
  else
    _agy__message 'agent name'
  fi
}

# Each project is `<gemini_dir>/config/projects/<id>.json` holding its `id`
# and display `name`; --project takes either.
_agy__projects() {
  local file content id name
  local -a projects match mbegin mend

  for file in "$(_agy__gemini_dir)"/config/projects/*.json(N.); do
    content="$(< ${file})" 2>/dev/null || continue
    id=${file:t:r} name=
    [[ ${content} =~ '"id"[[:space:]]*:[[:space:]]*"([^"]+)"' ]] && id=${match[1]}
    [[ ${content} =~ '"name"[[:space:]]*:[[:space:]]*"([^"]+)"' ]] && name=${match[1]}
    projects+=( "${id//:/\\:}${name:+:${name}}" )
  done

  if (( ${#projects} )); then
    _describe -t projects 'project' projects
  else
    _agy__message 'project id or name'
  fi
}

# Conversation stores are one SQLite file per conversation UUID, newest first.
_agy__conversations() {
  local dir
  local -a ids

  dir="$(_agy__app_data_dir)/conversations"
  if [[ -d ${dir} ]]; then
    ids=( ${dir}/*.db(Nom:t:r) )
  fi

  if (( ${#ids} )); then
    _describe -t conversations -V 'conversation' ids
  else
    _agy__message 'conversation id'
  fi
}

_agy__mcp_servers() {
  local -a lines servers

  _agy__state_args
  lines=( ${(f)"$(_call_program mcp-servers agy ${reply} mcp list 2>/dev/null </dev/null)"} )
  servers=( ${${${(M)lines:#[^[:space:]]*}:#NAME[[:space:]]*}%%[[:space:]]*} )

  if (( ${#servers} )); then
    _describe -t mcp-servers 'MCP server' servers
  else
    _agy__message 'MCP server name'
  fi
}

# `plugin list --json` is an array of objects; only their own `name` keys sit
# at four spaces of indentation.
_agy__installed_plugins() {
  local -a plugins

  _agy__state_args
  plugins=( ${(f)"$(_call_program plugins agy ${reply} plugin list --json 2>/dev/null </dev/null |
    sed -n 's/^    "name": "\(.*\)",\{0,1\}$/\1/p')"} )
  plugins=( ${(u)plugins:#} )

  if (( ${#plugins} )); then
    _describe -t plugins 'plugin' plugins
  else
    _agy__message 'plugin name'
  fi
}

_agy__top_commands() {
  local -a commands
  commands=(
    'agent:list available agents'
    'agents:list available agents (alias for agent)'
    'changelog:show changelog and release notes'
    'help:show help for subcommands'
    'install:configure environment paths and shell settings'
    'mcp:manage MCP servers (add, remove, list, enable, disable)'
    'mic-serve:serve this machine microphone to a CLI on another host'
    'models:list available models'
    'plugin:manage plugins (install, uninstall, list, enable, disable)'
    'plugins:alias for plugin'
    'remote-control:manage the remote-control background daemon (start, status, stop)'
    'update:update CLI'
  )
  _describe -t commands 'agy command' commands
}

_agy__plugin_commands() {
  local -a commands
  commands=(
    'disable:disable a plugin'
    'enable:enable a plugin'
    'help:show plugin help'
    'import:import plugins from gemini or claude'
    'install:install a plugin (supports plugin@marketplace)'
    'link:generate link to a marketplace'
    'list:list installed plugins'
    'uninstall:uninstall a plugin'
    "validate:check a plugin's manifest and files"
  )
  _describe -t plugin-commands 'plugin command' commands
}

_agy__mcp_commands() {
  local -a commands
  commands=(
    'add:add or update an MCP server configuration'
    'disable:disable an MCP server'
    'enable:enable an MCP server'
    'help:(hidden) show mcp usage'
    'list:list all configured MCP servers'
    'remove:remove an MCP server configuration'
  )
  _describe -t mcp-commands 'mcp command' commands
}

_agy__remote_control_commands() {
  local -a commands
  commands=(
    'help:(hidden) show remote-control usage'
    'serve:(hidden) run the remote-control daemon in the foreground (what start registers)'
    'start:register and start the remote-control daemon'
    'status:show the daemon status'
    'stop:stop the daemon and unregister it'
  )
  _describe -t remote-control-commands 'remote-control command' commands
}

_agy__plugin_import_sources() {
  local -a sources
  sources=(
    'claude:import plugins from Claude'
    'gemini:import plugins from Gemini'
  )
  _alternative \
    "sources:import source:((${(j: :)${(@q)sources}}))" \
    'directories:plugin directory:_files -/'
}

# Help flags shared by every subcommand.
_agy__help_flags() {
  reply=(
    '(- *)-h[show help]'
    '(- *)--help[show help]'
  )
}

_agy__top_option_specs() {
  reply=(
    # --- documented -------------------------------------------------------
    '*--add-dir=[add a directory to the workspace (repeatable)]:directory:_files -/'
    '--agent=[agent for the current CLI session]:agent:_agy__agents'
    '(-c --continue)'{-c,--continue}'[continue the most recent conversation]'
    '--conversation=[resume a previous conversation by ID]:conversation:_agy__conversations'
    '--dangerously-skip-permissions[auto-approve all tool permission requests without prompting]'
    '--disable-slash-commands[disable slash command and skill expansion in print mode]'
    '--effort=[reasoning effort for the current CLI session]:effort:(low medium high xhigh max)'
    '--input-format=[input format for print mode; stream-json reads NDJSON from stdin and requires --output-format stream-json]:format:(text stream-json)'
    '--json-schema=[JSON schema string or path to a schema file enforcing structured output]:schema:_files'
    '--log-file=[override CLI log file path]:path:_files'
    '--mode=[agent execution mode for this session]:mode:(accept-edits auto plan)'
    '--model=[model for the current CLI session]:model:_agy__models'
    '--new-project[create a new project for this session]'
    '--output-format=[output format for print mode]:format:(text json stream-json)'
    '(-p --print --prompt -i --prompt-interactive)'{-p,--print,--prompt}'=[run a single prompt non-interactively and print the response]:prompt: _agy__message "prompt"'
    '--print-timeout=[time limit for print mode; 0 waits until the turn completes]:duration: _agy__message "duration such as 5m0s"'
    '--project=[project ID or project name for the current CLI session]:project:_agy__projects'
    '(-i --prompt-interactive -p --print --prompt)'{-i,--prompt-interactive}'=[run an initial prompt interactively and continue the session]:prompt: _agy__message "prompt"'
    '--remote-control[create a remote connection for the CLI session on start up]'
    '--sandbox[run in a sandbox with terminal restrictions enabled]'
    '(- *)-h[show help]'
    '(- *)--help=-[show help, optionally filtering flags by regexp]::pattern: _agy__message "flag name regexp"'

    # --- hidden: Antigravity Hub, remote control and remote agents ----------
    '--hub[(hidden) run in hub server mode serving the Antigravity Hub web UI on a local port]'
    '--hub-port=[(hidden) port for the hub web UI, 0 selects the default]:port: _agy__message "port number"'
    '--remote-control-name=[(hidden) instance name for remote control mode]:name: _agy__message "instance name"'
    "--remote-agent[(hidden) run this session's conversations on remote agents; --project then names a remote project ID]"

    # --- hidden: stripped from --help in external builds -------------------
    '--app_data_dir=[(hidden) path where application data is stored, relative to the Gemini dir]:directory:_files -/'
    '--gemini_dir=[(hidden) path where Gemini files are stored]:directory:_files -/'
    '--bg-updater[(hidden) run as background update worker]'
    '--cdp_port=[(hidden) port for the Chrome DevTools Protocol]:port: _agy__message "port number"'
    '--use_local_chrome[(hidden) use a local Chrome instance]'
    '--local_chrome_headless[(hidden) run local Chrome in headless mode]'
    '--local_chrome_user_data_dir=[(hidden) Chrome user data directory]:directory:_files -/'
    '--release_base_url=[(hidden) base URL of the release server for the auto-updater]:url: _agy__message "release server base url"'
    '--csrf_token=[(hidden) CSRF token for the language server]:token: _agy__message "csrf token"'
    '--host_bridge_url=[(hidden) loopback base URL of a host that serves HostBridgeService]:url: _agy__message "loopback url such as http://127.0.0.1:PORT"'
    '--read_host_bridge_token_from_stdin[(hidden) read the bearer token for the host bridge from stdin]'
    '--use_host_auth[(hidden) use HostAuthProvider via HostBridgeService for OAuth authentication]'

    # --- hidden: base logging and runtime flags ----------------------------
    '(- *)--version[(hidden) print version and build info and exit]'
    '--logtostderr[(hidden) log to standard error instead of files]'
    '--alsologtostderr[(hidden) log to standard error as well as files]'
    '--stderrthreshold=[(hidden) logs at or above this severity go to stderr]:severity:((0\:INFO 1\:WARNING 2\:ERROR 3\:FATAL))'
    '--v=[(hidden) log level for V logs]:level: _agy__message "V log level"'
    '--vmodule=[(hidden) comma-separated pattern=N settings for file-filtered logging]:spec: _agy__message "pattern=N,pattern=N"'
    '--log_backtrace_at=[(hidden) emit a stack trace when logging hits this location]:location: _agy__message "file.go:234"'
    '--log_dir=[(hidden) write log files in this directory]:directory:_files -/'
    '--log_link=[(hidden) add symbolic links to the log files in this directory]:directory:_files -/'
    '--logbuflevel=[(hidden) buffer log messages logged at this level or lower]:level: _agy__message "level, -1 disables buffering"'
    '--disable_log_to_disk[(hidden) disable logging to local disk]'
    '--silent_init[(hidden) suppress the log message on initialization]'
    '--undefok=[(hidden) comma-separated flag names accepted even when undefined]:flags: _agy__message "flag1,flag2"'
    '--util_status_save_stack_trace[(hidden) save and display the full stack trace of non-ok util statuses]'
    '--syslog_on_start[(hidden) write to syslog on program start-up]'
    '--mlock_style=[(hidden) how memory will be locked]:style:(none startup all executable)'
    '--protosanitizer_use_old_annotation_sets[(hidden) use old Datapol annotation sets for proto data sanitization]'
    '--protosanitizer_use_streamz_for_sanitization_monitoring[(hidden) export sanitization metrics on /streamz]'
    '--protosanitizer_use_sensitivity_based_logic[(hidden) use sensitivity-based field sanitizers for proto data sanitization]'
  )
}

_agy__complete_help_only_leaf() {
  local -a specs
  _agy__help_flags
  specs=("${reply[@]}")

  _arguments -s ${specs[@]}
}

# `agy update` defines no flags at all, so even -h comes back as
# "flags provided but not defined: -h". Offer nothing rather than a rejection.
_agy__complete_update() {
  _agy__message 'update takes no options or arguments'
}

_agy__complete_install() {
  local -a specs
  _agy__help_flags
  specs=("${reply[@]}")

  _arguments -s \
    '--dir=[custom directory target to configure PATH for]:directory:_files -/' \
    '--skip-aliases[bypass shell profile alias purging]' \
    '--skip-path[bypass shell profile PATH appending]' \
    ${specs[@]}
}

_agy__complete_mic_serve() {
  local -a specs
  _agy__help_flags
  specs=("${reply[@]}")

  _arguments -s \
    '--addr=[address to listen on, keep it on loopback]:address: _agy__message "host:port, default 127.0.0.1:4713"' \
    ${specs[@]}
}

_agy__complete_mcp() {
  local curcontext="$curcontext" state line
  local -a specs
  typeset -A opt_args

  _agy__help_flags
  specs=("${reply[@]}")

  _arguments -C -s \
    ${specs[@]} \
    '1:mcp command:->command' \
    '*::mcp argument:->args'

  case $state in
    command)
      _agy__mcp_commands
      return
      ;;
  esac

  curcontext="${curcontext%:*:*}:agy-mcp-$words[1]:"

  case $words[1] in
    add)
      # Flags must precede <name>; a flag placed after it is rejected.
      _arguments -s -S \
        '(-t --type)'{-t,--type}'=[server type]:type:(stdio http)' \
        '*'{-e,--env}'=[environment variable KEY=value (repeatable)]:env: _agy__message "KEY=value"' \
        '*'{-H,--header}'=[HTTP header Key: Value (repeatable)]:header: _agy__message "Key: Value"' \
        ${specs[@]} \
        '1:name: _agy__message "unique name for the server"' \
        '2:command or url:_agy__mcp_command_or_url' \
        '*::argument:_files'
      ;;
    remove|enable|disable)
      _arguments -s \
        ${specs[@]} \
        '1:server:_agy__mcp_servers'
      ;;
    list)
      _agy__complete_help_only_leaf
      ;;
  esac
}

_agy__mcp_command_or_url() {
  # http/https URLs are detected automatically, so --type is usually unneeded.
  if [[ $PREFIX == (http|https)://* ]]; then
    _agy__message 'MCP server url'
    return
  fi
  _alternative \
    'commands:executable:_command_names -e' \
    'files:executable file:_files -g "*(-*)"' \
    'urls:url: _agy__message "http:// or https:// url"'
}

_agy__complete_plugin() {
  local curcontext="$curcontext" state line
  local -a specs
  typeset -A opt_args

  _agy__help_flags
  specs=("${reply[@]}")

  _arguments -C -s \
    ${specs[@]} \
    '1:plugin command:->command' \
    '*::plugin argument:->args'

  case $state in
    command)
      _agy__plugin_commands
      return
      ;;
  esac

  curcontext="${curcontext%:*:*}:agy-plugin-$words[1]:"

  # The plugin verbs parse almost no flags: a leading -h becomes a positional,
  # and `agy plugin uninstall -h` really does try to uninstall a plugin named
  # "-h". Only `list --json`, `validate --strict --json` and `import --force`
  # are read.
  case $words[1] in
    list)
      _arguments -s '--json[print installed plugins as JSON]'
      ;;
    import)
      _arguments -s \
        '--force[(hidden) re-import plugins that were already imported]' \
        '1::source:_agy__plugin_import_sources'
      ;;
    install)
      _arguments -s '1:target:_agy__plugin_install_target'
      ;;
    uninstall|enable|disable)
      _arguments -s '1:plugin:_agy__installed_plugins'
      ;;
    validate)
      _arguments -s \
        '--strict[fail on warnings as well as errors]' \
        '--json[print a machine-readable report]' \
        '1::plugin directory or plugin.json:_files -g "plugin.json(-.)"'
      ;;
    link)
      _arguments -s \
        '1:marketplace: _agy__message "marketplace name"' \
        '2:target: _agy__message "link target"'
      ;;
    help)
      _agy__message "agy plugin help takes no options or arguments"
      ;;
  esac
}

_agy__plugin_install_target() {
  _alternative \
    'directories:plugin directory:_files -/' \
    'plugins:plugin or plugin@marketplace: _agy__message "plugin or plugin@marketplace"'
}

_agy__complete_remote_control() {
  local curcontext="$curcontext" state line
  local -a specs
  typeset -A opt_args

  _agy__help_flags
  specs=("${reply[@]}")

  _arguments -C -s \
    ${specs[@]} \
    '1:remote-control command:->command' \
    '*::remote-control argument:->args'

  case $state in
    command)
      _agy__remote_control_commands
      return
      ;;
  esac

  curcontext="${curcontext%:*:*}:agy-remote-control-$words[1]:"

  case $words[1] in
    start)
      _arguments -s \
        '--name=[instance name shown in Remote Control for this machine]:name: _agy__message "instance name"' \
        '--session[register the daemon login-scoped (stops at logout) instead of starting at boot]' \
        ${specs[@]}
      ;;
    status|stop)
      _arguments -s ${specs[@]}
      ;;
    serve|help)
      _agy__message "agy remote-control $words[1] takes no options or arguments"
      ;;
  esac
}

# `help` takes a bare subcommand name; -h and --help land in the same slot and
# come back as "unknown subcommand", so they are deliberately not offered.
_agy__complete_help() {
  _arguments -s '1:agy command:_agy__top_commands'
}

function _agy() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a specs _agy_line

  _agy_line=( "${words[@]}" )
  _agy__top_option_specs
  specs=("${reply[@]}")

  _arguments -C -s \
    ${specs[@]} \
    '1:agy command:->command' \
    '*::agy argument:->args'

  case $state in
    command)
      _agy__top_commands
      return
      ;;
    args)
      curcontext="${curcontext%:*:*}:agy-$words[1]:"
      case $words[1] in
        agent|agents|changelog|models)
          _agy__complete_help_only_leaf
          ;;
        update)
          _agy__complete_update
          ;;
        help)
          _agy__complete_help
          ;;
        install)
          _agy__complete_install
          ;;
        mcp)
          _agy__complete_mcp
          ;;
        mic-serve)
          _agy__complete_mic_serve
          ;;
        plugin|plugins)
          _agy__complete_plugin
          ;;
        remote-control)
          _agy__complete_remote_control
          ;;
      esac
      ;;
  esac
}

_agy "$@"

